---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NoteGraph from '../components/NoteGraph.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { tagSlug } from '../lib/tags';
import type { NoteGraph as NoteGraphData } from '../lib/noteGraph';

type Props = CollectionEntry<'blog'>['data'] & {
	graph?: NoteGraphData;
};

const { title, description, pubDate, updatedDate, heroImage, graph, tags = [] } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const heroImageIsString = typeof heroImage === 'string';
const heroImageIsPublicUrl = heroImageIsString && (heroImage.startsWith('/') || heroImage.startsWith('http'));
const heroImageIsImported = heroImage && !heroImageIsString;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<div class="reading-progress" aria-hidden="true"><span></span></div>
		<Header />
		<main class="post-page">
			<div class:list={['post-grid', { 'without-graph': !graph }]}>
				<ProfileCard />

				<article class="post-card firefly-card">
					<header class="post-heading">
						<p class="eyebrow">Notebook</p>
						<h1>{title}</h1>
						{description && <p class="description">{description}</p>}
						<div class="meta">
							<span><FormattedDate date={pubDate} /></span>
							{updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
							{tags.map((tag) => <a href={`${baseUrl}tags/${tagSlug(tag)}/`}>#{tag}</a>)}
						</div>
					</header>

					{
						(heroImageIsImported || heroImageIsPublicUrl) && (
							<div class="hero-image">
								{heroImageIsImported && <Image width={1100} height={460} src={heroImage} alt="" />}
								{heroImageIsPublicUrl && <img src={heroImage} alt="" />}
							</div>
						)
					}

					<div class="prose markdown-body">
						<slot />
					</div>
				</article>

				{graph && <NoteGraph graph={graph} />}
			</div>
		</main>
		<Footer />
		<script>
			const progressBar = document.querySelector('.reading-progress span');
			const article = document.querySelector('.post-card');
			let progressFrame = 0;
			function updateReadingProgress() {
				progressFrame = 0;
				if (!progressBar || !article) return;
				const rect = article.getBoundingClientRect();
				const distance = Math.max(article.scrollHeight - window.innerHeight * 0.45, 1);
				const progress = Math.min(Math.max(-rect.top / distance, 0), 1);
				progressBar.style.transform = `scaleX(${progress})`;
			}
			window.addEventListener('scroll', () => {
				if (progressFrame) return;
				progressFrame = window.requestAnimationFrame(updateReadingProgress);
			}, { passive: true });
			updateReadingProgress();
		</script>
	</body>
</html>

<style>
	.post-page {
		width: min(1440px, calc(100% - 2rem));
		padding-top: 2rem;
	}

	.post-grid {
		display: grid;
		grid-template-columns: 13.5rem minmax(0, 780px) 19rem;
		justify-content: center;
		gap: 1.2rem;
		align-items: start;
	}

	.post-grid.without-graph {
		grid-template-columns: 13.5rem minmax(0, 820px);
	}

	.post-card {
		min-width: 0;
		overflow: hidden;
	}

	.reading-progress {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 100;
		width: 100%;
		height: 3px;
		pointer-events: none;
	}

	.reading-progress span {
		display: block;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, oklch(0.68 0.15 250), oklch(0.72 0.13 165));
		transform: scaleX(0);
		transform-origin: left;
		will-change: transform;
	}

	.post-heading {
		padding: 2rem 2.25rem 1.25rem;
	}

	.eyebrow {
		margin: 0 0 0.55rem;
		color: var(--primary);
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.08;
	}

	.description {
		max-width: 700px;
		margin: 0.85rem 0 0;
		color: rgb(var(--gray));
		font-size: 1rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.48rem;
		margin-top: 1rem;
		color: rgb(var(--gray));
		font-size: 0.78rem;
	}

	.meta a {
		border-radius: 0.45rem;
		background: var(--btn-regular-bg);
		padding: 0.14rem 0.42rem;
		color: var(--btn-content);
		text-decoration: none;
	}

	.meta a:hover {
		background: var(--btn-regular-bg-hover);
	}

	.hero-image {
		padding: 0 1rem;
	}

	.hero-image img {
		display: block;
		width: 100%;
		max-height: 460px;
		object-fit: cover;
	}

	.prose {
		padding: 1.6rem 2.25rem 2.25rem;
		color: rgb(var(--gray-dark));
		font-size: clamp(1rem, 1.25vw, 1.06rem);
		line-height: 1.96;
	}

	.prose :global(> *:first-child) {
		margin-top: 0;
	}

	.prose :global(> *:last-child) {
		margin-bottom: 0;
	}

	.prose :global(h1),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		scroll-margin-top: 5.5rem;
	}

	.prose :global(h2) {
		margin-top: 2.7rem;
		border-top: 1px dashed var(--line-color);
		padding-top: 1.35rem;
		font-size: clamp(1.35rem, 3vw, 1.9rem);
	}

	.prose :global(h2)::before {
		display: inline-block;
		width: 0.38rem;
		height: 1.05em;
		margin-right: 0.55rem;
		border-radius: 999px;
		background: var(--primary);
		vertical-align: -0.14em;
		content: '';
	}

	.prose :global(h3) {
		margin-top: 2rem;
		font-size: 1.22rem;
	}

	.prose :global(h3)::before {
		color: var(--primary);
		content: '# ';
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1.2rem;
	}

	.prose :global(p) {
		max-width: 74ch;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.45rem;
	}

	.prose :global(li)::marker {
		color: var(--primary);
	}

	.prose :global(li + li) {
		margin-top: 0.35rem;
	}

	.prose :global(input[type='checkbox']) {
		width: 1rem;
		height: 1rem;
		margin-right: 0.35rem;
		accent-color: var(--primary);
		vertical-align: -0.12em;
	}

	.prose :global(a) {
		border-radius: 0.3rem;
		font-weight: 500;
		text-decoration-color: var(--link-underline);
		text-decoration-style: dashed;
	}

	.prose :global(a:hover) {
		background: var(--btn-plain-bg-hover);
		text-decoration-color: transparent;
	}

	.prose :global(img) {
		display: block;
		margin: 1.8rem auto;
		box-shadow: 0 18px 48px rgba(30, 34, 52, 0.12);
	}

	.prose :global(kbd) {
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-bottom-width: 2px;
		border-radius: 0.45rem;
		background: rgba(255, 255, 255, 0.75);
		padding: 0.08rem 0.35rem;
		color: rgb(var(--gray-dark));
		font-family: 'JetBrains Mono', ui-monospace, monospace;
		font-size: 0.82em;
	}

	.prose :global(mark) {
		border-radius: 0.35rem;
		background: oklch(0.88 0.08 90 / 0.55);
		padding: 0.02rem 0.24rem;
	}

	.prose :global(details) {
		margin: 1.4rem 0;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.52);
		padding: 0.85rem 1rem;
	}

	.prose :global(summary) {
		cursor: pointer;
		color: rgb(var(--black));
		font-weight: 700;
	}

	.prose :global(table) {
		display: block;
		margin: 1.6rem 0;
		overflow-x: auto;
		border: 1px solid rgba(var(--gray-light), 0.95);
		border-radius: 0.75rem;
		background: white;
	}

	.prose :global(tbody tr:hover) {
		background: oklch(0.97 0.012 var(--hue));
	}

	.prose :global(pre) {
		margin: 1.6rem 0;
	}

	.prose :global(pre code) {
		border: 0;
		background: transparent;
		padding: 0;
	}

	.prose :global(.expressive-code) {
		margin: 1.6rem 0;
	}

	/* The note body is deliberately calmer and wider than the surrounding chrome. */
	.prose {
		padding: 1.8rem clamp(1.35rem, 4vw, 2.8rem) 3rem;
		color: oklch(0.32 0.018 265);
		font-size: clamp(1rem, 0.4vw + 0.94rem, 1.08rem);
		line-height: 1.92;
	}

	.prose :global(p) {
		max-width: 72ch;
		margin: 0 0 1.35rem;
	}

	.prose :global(h2) {
		position: relative;
		margin: 3.2rem 0 1.15rem;
		border-top: 0;
		padding: 0 0 0 1rem;
		font-size: clamp(1.38rem, 1.2vw + 1rem, 1.9rem);
		line-height: 1.35;
	}

	.prose :global(h2)::before {
		position: absolute;
		left: 0;
		top: 0.18em;
		display: block;
		width: 0.28rem;
		height: 0.9em;
		margin: 0;
		border-radius: 999px;
		background: linear-gradient(180deg, var(--primary), oklch(0.7 0.13 165));
		content: '';
	}

	.prose :global(h3) {
		margin: 2.2rem 0 0.75rem;
		font-size: 1.25rem;
	}

	.prose :global(h3)::before {
		margin-right: 0.35rem;
		color: oklch(0.7 0.13 165);
		content: '✦';
		font-size: 0.72em;
	}

	.prose :global(h4) {
		margin-top: 1.7rem;
		font-size: 1.06rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		max-width: 70ch;
		margin: 0 0 1.35rem;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		padding-left: 0.2rem;
	}

	.prose :global(li + li) {
		margin-top: 0.45rem;
	}

	.prose :global(blockquote) {
		max-width: 70ch;
		margin: 1.8rem 0;
		border: 1px solid rgba(100, 105, 125, 0.14);
		border-left: 4px solid oklch(0.7 0.13 165);
		border-radius: 0 8px 8px 0;
		background: linear-gradient(100deg, oklch(0.96 0.025 165), rgba(255, 255, 255, 0.5));
		padding: 1rem 1.15rem;
		color: rgb(var(--gray-dark));
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(:not(pre) > code) {
		border: 1px solid rgba(100, 105, 125, 0.12);
		background: oklch(0.94 0.025 250);
		color: oklch(0.46 0.13 250);
		font-size: 0.84em;
	}

	.prose :global(pre) {
		margin: 1.8rem 0;
		border: 1px solid rgba(30, 32, 42, 0.1);
		box-shadow: 0 18px 42px rgba(30, 34, 52, 0.1);
	}

	.prose :global(.expressive-code) {
		margin: 1.8rem 0;
	}

	.prose :global(img) {
		max-height: 680px;
		border-radius: 8px;
		object-fit: contain;
	}

	.prose :global(figure) {
		margin: 1.8rem 0;
	}

	.prose :global(figcaption) {
		margin-top: -1rem;
		color: rgb(var(--gray));
		font-size: 0.78rem;
		text-align: center;
	}

	.prose :global(table) {
		margin: 1.8rem 0;
		border-color: rgba(100, 105, 125, 0.16);
		box-shadow: 0 10px 28px rgba(30, 34, 52, 0.05);
	}

	.prose :global(th) {
		background: oklch(0.94 0.025 250);
		font-size: 0.82rem;
	}

	.prose :global(hr) {
		max-width: 72ch;
		margin: 2.8rem 0;
		border-top-style: solid;
		border-top-color: rgba(100, 105, 125, 0.18);
	}

	@media (max-width: 1180px) {
		.post-grid {
			grid-template-columns: 12rem minmax(0, 1fr) 16rem;
		}

		.post-grid.without-graph {
			grid-template-columns: 12rem minmax(0, 1fr);
		}
	}

	@media (max-width: 980px) {
		.post-grid,
		.post-grid.without-graph {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.post-heading {
			padding: 1.35rem 1.15rem 1rem;
		}

		.prose {
			padding: 1rem 1.15rem 1.5rem;
			font-size: 1rem;
		}

		.hero-image {
			padding: 0 0.75rem;
		}
	}
</style>
