---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NoteGraph from '../components/NoteGraph.astro';
import type { NoteGraph as NoteGraphData } from '../lib/noteGraph';

type Props = CollectionEntry<'blog'>['data'] & {
	graph?: NoteGraphData;
};

const { title, description, pubDate, updatedDate, heroImage, graph } = Astro.props;
const heroImageIsString = typeof heroImage === 'string';
const heroImageIsPublicUrl = heroImageIsString && (heroImage.startsWith('/') || heroImage.startsWith('http'));
const heroImageIsImported = heroImage && !heroImageIsString;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="article-hero">
					<p class="kicker">Notebook</p>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
					<div class="meta">
						<span><FormattedDate date={pubDate} /></span>
						{updatedDate && <span>更新于 <FormattedDate date={updatedDate} /></span>}
					</div>
				</header>

				{
					(heroImageIsImported || heroImageIsPublicUrl) && (
						<div class="hero-image">
							{heroImageIsImported && <Image width={1180} height={520} src={heroImage} alt="" />}
							{heroImageIsPublicUrl && <img src={heroImage} alt="" />}
						</div>
					)
				}

				<div class:list={['article-shell', { 'without-graph': !graph }]}>
					<aside class="reading-meta" aria-label="文章信息">
						<span>Published</span>
						<strong><FormattedDate date={pubDate} /></strong>
					</aside>

					<div class="prose">
						<slot />
					</div>

					{graph && <NoteGraph graph={graph} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: none;
		padding: 0;
	}

	article {
		padding: 3.4rem 0 1rem;
	}

	.article-hero {
		width: min(980px, calc(100% - 2rem));
		margin: 0 auto 2.4rem;
	}

	.kicker {
		margin: 0 0 0.8rem;
		color: var(--accent);
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	h1 {
		max-width: 920px;
		margin: 0;
		font-size: clamp(2.2rem, 6.4vw, 4.9rem);
		line-height: 1.02;
	}

	.description {
		max-width: 720px;
		margin: 1.05rem 0 0;
		color: rgb(var(--gray));
		font-size: clamp(1rem, 1.8vw, 1.12rem);
		line-height: 1.74;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 1.35rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}

	.meta span {
		display: inline-flex;
		align-items: center;
		min-height: 30px;
		border: 1px solid rgba(var(--black), 0.09);
		border-radius: 999px;
		padding: 0 0.75rem;
		background: rgba(var(--surface), 0.68);
	}

	.hero-image {
		width: min(1180px, calc(100% - 2rem));
		margin: 0 auto 2.5rem;
	}

	.hero-image img {
		display: block;
		width: 100%;
		max-height: 520px;
		border-radius: 8px;
		box-shadow: var(--lift-shadow);
		object-fit: cover;
	}

	.article-shell {
		display: grid;
		grid-template-columns: minmax(112px, 150px) minmax(0, 820px) minmax(250px, 300px);
		gap: clamp(1rem, 2.5vw, 2rem);
		align-items: start;
		width: min(1320px, calc(100% - 2rem));
		margin: 0 auto;
	}

	.article-shell.without-graph {
		grid-template-columns: minmax(112px, 150px) minmax(0, 840px);
		width: min(1040px, calc(100% - 2rem));
	}

	.reading-meta {
		position: sticky;
		top: 5rem;
		display: grid;
		gap: 0.25rem;
		border-top: 1px solid var(--line);
		padding-top: 1rem;
		color: rgb(var(--gray));
		font-size: 0.76rem;
	}

	.reading-meta strong {
		color: rgb(var(--black));
		font-size: 0.88rem;
		line-height: 1.35;
	}

	.prose {
		min-width: 0;
		border: 1px solid rgba(var(--black), 0.075);
		border-radius: 8px;
		background: rgba(var(--surface), 0.88);
		box-shadow: var(--soft-shadow);
		padding: clamp(1.35rem, 4vw, 3.25rem);
		color: rgb(var(--gray-dark));
		font-size: clamp(1rem, 1.4vw, 1.06rem);
		line-height: 1.92;
	}

	.prose :global(> *:first-child) {
		margin-top: 0;
	}

	.prose :global(> *:last-child) {
		margin-bottom: 0;
	}

	.prose :global(h1),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		scroll-margin-top: 5rem;
	}

	.prose :global(h2) {
		margin-top: 3rem;
		border-top: 1px solid rgba(var(--gray-light), 0.9);
		padding-top: 1.55rem;
		font-size: clamp(1.45rem, 3vw, 2rem);
		line-height: 1.28;
	}

	.prose :global(h3) {
		margin-top: 2.1rem;
		font-size: 1.24rem;
		line-height: 1.36;
	}

	.prose :global(h4) {
		margin-top: 1.6rem;
		color: rgb(var(--gray-dark));
		font-size: 1.03rem;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-bottom: 1.2rem;
	}

	.prose :global(p) {
		max-width: 72ch;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.45rem;
	}

	.prose :global(li) {
		padding-left: 0.15rem;
	}

	.prose :global(li + li) {
		margin-top: 0.38rem;
	}

	.prose :global(a) {
		font-weight: 500;
		text-decoration-style: dotted;
	}

	.prose :global(img) {
		display: block;
		margin: 2rem auto;
		border: 1px solid rgba(var(--black), 0.07);
		box-shadow: 0 14px 36px rgba(var(--gray), 0.16);
	}

	.prose :global(table) {
		display: block;
		margin: 1.6rem 0;
		overflow-x: auto;
		border: 1px solid rgba(var(--gray-light), 0.95);
		border-radius: 8px;
		background: white;
	}

	.prose :global(pre code) {
		border: 0;
		background: transparent;
		padding: 0;
	}

	.prose :global(.expressive-code) {
		margin: 1.65rem 0;
	}

	.prose :global(.expressive-code .frame) {
		box-shadow: none;
	}

	@media (max-width: 1120px) {
		.article-shell {
			grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
		}

		.reading-meta {
			display: none;
		}
	}

	@media (max-width: 860px) {
		article {
			padding-top: 2rem;
		}

		.article-shell,
		.article-shell.without-graph {
			grid-template-columns: 1fr;
			width: min(100% - 1rem, 820px);
		}

		.article-hero,
		.hero-image {
			width: min(100% - 1rem, 980px);
		}

		.prose {
			padding: 1.15rem;
			line-height: 1.82;
		}
	}
</style>
