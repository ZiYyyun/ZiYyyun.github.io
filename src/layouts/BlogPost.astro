---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import NoteGraph from '../components/NoteGraph.astro';
import type { NoteGraph as NoteGraphData } from '../lib/noteGraph';

type Props = CollectionEntry<'blog'>['data'] & {
	graph?: NoteGraphData;
};

const { title, description, pubDate, updatedDate, heroImage, graph } = Astro.props;
const heroImageIsString = typeof heroImage === 'string';
const heroImageIsPublicUrl = heroImageIsString && (heroImage.startsWith('/') || heroImage.startsWith('http'));
const heroImageIsImported = heroImage && !heroImageIsString;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
				box-shadow: var(--box-shadow);
			}
			.article-shell {
				display: grid;
				grid-template-columns: minmax(0, 760px) minmax(220px, 280px);
				gap: 2rem;
				width: min(1120px, calc(100% - 2rem));
				margin: 0 auto;
			}
			.prose {
				max-width: 100%;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			@media (max-width: 960px) {
				.article-shell {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImageIsImported && <Image width={1020} height={510} src={heroImage} alt="" />}
					{heroImageIsPublicUrl && <img src={heroImage} alt="" />}
				</div>
				<div class="article-shell">
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											最后更新于 <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
						<slot />
					</div>
					{graph && <NoteGraph graph={graph} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
