---
import ForceNoteGraph from './ForceNoteGraph';
import type { NoteGraph } from '../lib/noteGraph';

type Props = {
	graph: NoteGraph;
};

const { graph } = Astro.props;
---

<aside class="note-graph" aria-label="笔记关系图谱">
	<div class="graph-head">
		<h2>关系图谱</h2>
		<span>{graph.nodes.length} nodes</span>
	</div>
	<ForceNoteGraph graph={graph} client:load />
</aside>

<style>
	.note-graph {
		position: sticky;
		top: 5rem;
		align-self: start;
		padding: 0.85rem;
		border: 1px solid rgba(var(--black), 0.08);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.9);
		box-shadow: 0 18px 48px rgba(var(--gray), 15%);
		backdrop-filter: blur(16px);
	}

	.graph-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.65rem;
	}

	h2 {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.2;
	}

	span {
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	:global(.force-note-graph svg) {
		display: block;
		width: 100%;
		aspect-ratio: 1.08;
		border-radius: 8px;
		background:
			linear-gradient(90deg, rgba(var(--gray-light), 0.36) 1px, transparent 1px),
			linear-gradient(0deg, rgba(var(--gray-light), 0.36) 1px, transparent 1px),
			rgb(var(--paper));
		background-size: 28px 28px;
	}

	:global(.force-note-graph line) {
		stroke: rgba(var(--gray), 0.42);
		stroke-width: 1.1;
	}

	:global(.force-note-graph circle) {
		fill: rgb(var(--gray));
		opacity: 0.72;
		transition:
			opacity 0.2s ease,
			r 0.2s ease;
	}

	:global(.force-note-graph circle.active) {
		fill: rgb(var(--black));
		opacity: 1;
	}

	:global(.force-note-graph a:hover circle) {
		opacity: 1;
	}

	:global(.force-note-graph ul) {
		display: grid;
		gap: 0.38rem;
		max-height: 170px;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
		overflow: auto;
	}

	:global(.force-note-graph li a) {
		display: block;
		color: rgb(var(--gray-dark));
		font-size: 0.78rem;
		line-height: 1.35;
		text-decoration: none;
	}

	:global(.force-note-graph li.active a) {
		color: rgb(var(--black));
		font-weight: 700;
	}
</style>
