---
import ForceNoteGraph from './ForceNoteGraph';
import type { NoteGraph } from '../lib/noteGraph';

type Props = {
	graph: NoteGraph;
};

const { graph } = Astro.props;
---

<aside class="note-graph firefly-card" aria-label="笔记关系图谱">
	<div class="graph-head">
		<h2>关系图谱</h2>
		<span>{graph.nodes.length} nodes</span>
	</div>
	<ForceNoteGraph graph={graph} client:load />
</aside>

<style>
	.note-graph {
		position: sticky;
		top: 5.5rem;
		align-self: start;
		overflow: hidden;
		padding: 0.8rem;
	}

	.graph-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
		padding: 0.25rem 0.25rem 0;
	}

	h2 {
		margin: 0;
		font-size: 0.92rem;
	}

	span {
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	:global(.force-note-graph svg) {
		display: block;
		width: 100%;
		aspect-ratio: 1.1;
		border: 1px solid rgba(var(--black), 0.06);
		border-radius: 8px;
		background:
			linear-gradient(90deg, rgba(70, 74, 92, 0.045) 1px, transparent 1px),
			linear-gradient(rgba(70, 74, 92, 0.045) 1px, transparent 1px),
			linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(244, 245, 249, 0.9));
		background-size: 24px 24px, 24px 24px, auto;
		touch-action: none;
	}

	:global(.force-note-graph line) {
		stroke: oklch(0.58 0.1 var(--hue) / 0.3);
		stroke-width: 1;
	}

	:global(.force-note-graph circle) {
		fill: var(--primary);
		opacity: 0.72;
		stroke: rgba(255, 255, 255, 0.9);
		stroke-width: 1.5;
		transition:
			opacity 0.2s ease,
			r 0.2s ease;
	}

	:global(.force-note-graph circle.active) {
		fill: oklch(0.65 0.18 25);
		opacity: 1;
	}

	:global(.force-note-graph circle.tag) {
		fill: oklch(0.62 0.13 165);
		stroke-width: 1;
	}

	:global(.force-note-graph .tag text) {
		fill: oklch(0.46 0.1 165);
		font-size: 7.5px;
	}

	:global(.force-note-graph a:hover circle) {
		opacity: 1;
	}

	:global(.force-note-graph .node) {
		cursor: grab;
	}

	:global(.force-note-graph .node:active) {
		cursor: grabbing;
	}

	:global(.force-note-graph text) {
		fill: rgb(var(--gray-dark));
		font-family: 'Noto Sans SC', sans-serif;
		font-size: 8px;
		font-weight: 500;
		opacity: 0;
		paint-order: stroke;
		pointer-events: none;
		stroke: rgba(255, 255, 255, 0.95);
		stroke-width: 2.8px;
		stroke-linejoin: round;
		transition: opacity 0.18s ease;
	}

	:global(.force-note-graph .node.is-highlighted text) {
		opacity: 1;
		font-weight: 700;
	}

	:global(.force-note-graph .tag text) {
		opacity: 0.72;
	}

	:global(.force-note-graph .graph-status) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.7rem 0.2rem 0.05rem;
	}

	:global(.force-note-graph .graph-status span) {
		min-width: 0;
		overflow: hidden;
		color: rgb(var(--gray-dark));
		font-size: 0.72rem;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:global(.force-note-graph .graph-status small) {
		flex: 0 0 auto;
		color: rgb(var(--gray));
		font-size: 0.64rem;
	}

	@media (max-width: 860px) {
		.note-graph {
			position: static;
		}
	}
</style>
