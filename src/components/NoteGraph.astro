---
import ForceNoteGraph from './ForceNoteGraph';
import type { NoteGraph } from '../lib/noteGraph';

type Props = {
	graph: NoteGraph;
};

const { graph } = Astro.props;
---

<aside class="note-graph" aria-label="笔记关系图谱">
	<div class="graph-head">
		<h2>关系图谱</h2>
		<span>{graph.nodes.length} nodes</span>
	</div>
	<ForceNoteGraph graph={graph} client:load />
</aside>

<style>
	.note-graph {
		position: sticky;
		top: 5rem;
		align-self: start;
		border: 1px solid rgba(var(--black), 0.07);
		border-radius: 8px;
		background: rgba(var(--surface), 0.84);
		box-shadow: 0 18px 46px rgba(24, 30, 38, 0.07);
		padding: 0.9rem;
		backdrop-filter: blur(18px);
	}

	.graph-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	h2 {
		margin: 0;
		font-size: 0.92rem;
	}

	span {
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	:global(.force-note-graph svg) {
		display: block;
		width: 100%;
		aspect-ratio: 1.06;
		border: 1px solid rgba(var(--black), 0.06);
		border-radius: 8px;
		background:
			radial-gradient(circle at 50% 40%, rgba(47, 111, 115, 0.1), transparent 56%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(var(--paper), 0.62)),
			rgb(var(--paper));
	}

	:global(.force-note-graph line) {
		stroke: rgba(47, 111, 115, 0.34);
		stroke-width: 1.05;
	}

	:global(.force-note-graph circle) {
		fill: var(--accent);
		opacity: 0.68;
		transition:
			opacity 0.2s ease,
			r 0.2s ease;
	}

	:global(.force-note-graph circle.active) {
		fill: var(--accent-warm);
		opacity: 1;
	}

	:global(.force-note-graph a:hover circle) {
		opacity: 1;
	}

	:global(.force-note-graph ul) {
		display: grid;
		gap: 0.36rem;
		max-height: 160px;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
		overflow: auto;
	}

	:global(.force-note-graph li a) {
		display: block;
		color: rgb(var(--gray-dark));
		font-size: 0.76rem;
		line-height: 1.38;
		text-decoration: none;
	}

	:global(.force-note-graph li.active a) {
		color: rgb(var(--black));
		font-weight: 700;
	}

	@media (max-width: 860px) {
		.note-graph {
			position: static;
		}
	}
</style>
