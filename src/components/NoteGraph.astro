---
import type { NoteGraph } from '../lib/noteGraph';

type Props = {
	graph: NoteGraph;
};

const { graph } = Astro.props;
const radius = 78;
const center = 100;
const activeNode = graph.nodes.find((node) => node.active);
const relatedNodes = graph.nodes.filter((node) => !node.active);
const positionedNodes = [
	...(activeNode ? [{ ...activeNode, x: center, y: center }] : []),
	...relatedNodes.map((node, index) => {
		const angle = (Math.PI * 2 * index) / Math.max(relatedNodes.length, 1) - Math.PI / 2;
		return {
			...node,
			x: center + Math.cos(angle) * radius,
			y: center + Math.sin(angle) * radius,
		};
	}),
];
const nodePositions = new Map(positionedNodes.map((node) => [node.id, node]));
---

<aside class="note-graph" aria-label="笔记关系图谱">
	<h2>关系图谱</h2>
	{
		graph.nodes.length > 1 ? (
			<svg viewBox="0 0 200 200" role="img" aria-label="当前笔记和已发布关联笔记">
				{graph.edges.map((edge) => {
					const from = nodePositions.get(edge.from);
					const to = nodePositions.get(edge.to);
					if (!from || !to) return null;
					return <line x1={from.x} y1={from.y} x2={to.x} y2={to.y} />;
				})}
				{positionedNodes.map((node) => (
					<a href={node.url}>
						<circle cx={node.x} cy={node.y} r={node.active ? 12 : 8} class:list={{ active: node.active }} />
						<title>{node.title}</title>
					</a>
				))}
			</svg>
		) : (
			<p class="empty">暂无已发布关联笔记</p>
		)
	}

	<section>
		<h3>出链</h3>
		{
			graph.outgoing.length ? (
				<ul>
					{graph.outgoing.map((node) => (
						<li><a href={node.url}>{node.title}</a></li>
					))}
				</ul>
			) : (
				<p class="empty">暂无</p>
			)
		}
	</section>

	<section>
		<h3>反链</h3>
		{
			graph.backlinks.length ? (
				<ul>
					{graph.backlinks.map((node) => (
						<li><a href={node.url}>{node.title}</a></li>
					))}
				</ul>
			) : (
				<p class="empty">暂无</p>
			)
		}
	</section>
</aside>

<style>
	.note-graph {
		position: sticky;
		top: 5rem;
		align-self: start;
		padding: 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: white;
	}

	h2,
	h3 {
		margin: 0;
		line-height: 1.2;
	}

	h2 {
		font-size: 1rem;
	}

	h3 {
		margin-top: 1rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	svg {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		margin: 0.75rem 0;
	}

	line {
		stroke: rgb(var(--gray-light));
		stroke-width: 1.5;
	}

	circle {
		fill: rgb(var(--accent));
		opacity: 0.7;
		transition:
			opacity 0.2s ease,
			r 0.2s ease;
	}

	circle.active {
		fill: rgb(var(--black));
		opacity: 1;
	}

	a:hover circle {
		opacity: 1;
	}

	ul {
		display: grid;
		gap: 0.5rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	li a {
		color: rgb(var(--black));
		font-size: 0.9rem;
		text-decoration: none;
	}

	li a:hover {
		color: rgb(var(--accent));
	}

	.empty {
		margin: 0.5rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
</style>
