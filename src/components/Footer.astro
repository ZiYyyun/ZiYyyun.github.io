---
const today = new Date();
---

<footer>
	<span>&copy; {today.getFullYear()} ZiYyun</span>
	<span>Built with Astro</span>
</footer>

<style>
	footer {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		padding: 3rem 1rem 4rem;
		color: rgb(var(--gray));
		font-size: 0.82rem;
	}

	span + span::before {
		content: '/';
		margin-right: 0.75rem;
		color: rgba(var(--gray), 0.55);
	}
</style>
