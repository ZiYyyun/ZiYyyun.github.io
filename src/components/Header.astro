---
import { BookOpen, Home, User } from '@lucide/astro';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="fuwari-card">
		<a class="brand fuwari-button" href={import.meta.env.BASE_URL}>
			<Home size={21} />
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links" aria-label="Primary navigation">
			<HeaderLink href="/"><Home size={17} />首页</HeaderLink>
			<HeaderLink href="/blog"><BookOpen size={17} />笔记</HeaderLink>
			<HeaderLink href="/projects">项目</HeaderLink>
			<HeaderLink href="/setup">设备</HeaderLink>
			<HeaderLink href="/about"><User size={17} />关于</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 0 1rem;
		pointer-events: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(var(--page-width), 100%);
		height: 4.5rem;
		margin: 0 auto;
		border-top-left-radius: 0;
		border-top-right-radius: 0;
		padding: 0 0.85rem;
		pointer-events: auto;
	}

	.brand {
		gap: 0.5rem;
		height: 3.25rem;
		padding: 0 1rem;
		font-size: 0.95rem;
		font-weight: 700;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.internal-links::-webkit-scrollbar {
		display: none;
	}

	@media (max-width: 640px) {
		header {
			padding: 0;
		}

		nav {
			border-radius: 0;
		}

		.brand span {
			display: none;
		}
	}
</style>
