---
import {
	ArrowUpRight,
	BookOpen,
	Box,
	Cpu,
	GitBranch,
	Mail,
	MonitorCog,
	QrCode,
	Send,
	SquareTerminal,
	Star,
} from '@lucide/astro';
import { getCollection } from 'astro:content';
import BackgroundImage from '../assets/firefly-banner.png';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getTagSummaries } from '../lib/tags';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const baseUrl = import.meta.env.BASE_URL;
const tags = getTagSummaries(posts, baseUrl);
const recentPosts = posts.slice(0, 4);

function getShortTagName(name: string) {
	const parts = name.split(/[\\/]/).filter(Boolean);
	return parts.at(-1) ?? name;
}

type Repo = {
	name: string;
	description: string;
	htmlUrl: string;
	language: string;
	stars: number;
};

const fallbackRepos: Repo[] = [
	{
		name: 'ZiYyun-ObsidianUnivrse',
		description: 'Obsidian 长期笔记与博客内容的源仓库。',
		htmlUrl: 'https://github.com/ZiYyyun/ZiYyun-ObsidianUnivrse',
		language: 'Markdown',
		stars: 0,
	},
	{
		name: 'ZiYyun.github.io',
		description: '当前个人博客与自动发布流水线。',
		htmlUrl: 'https://github.com/ZiYyyun/ZiYyun.github.io',
		language: 'Astro',
		stars: 0,
	},
];

async function loadRepos(): Promise<Repo[]> {
	try {
		const response = await fetch('https://api.github.com/users/ZiYyyun/repos?sort=updated&per_page=6');
		if (!response.ok) return fallbackRepos;
		const data = await response.json();
		return data
			.filter((repo: any) => !repo.fork)
			.slice(0, 4)
			.map((repo: any) => ({
				name: repo.name,
				description: repo.description || '持续维护中的代码与实验记录。',
				htmlUrl: repo.html_url,
				language: repo.language || 'Repository',
				stars: repo.stargazers_count || 0,
			}));
	} catch {
		return fallbackRepos;
	}
}

const repos = await loadRepos();
const toolGroups = [
	{ label: '站点与内容', items: ['Astro', 'React', 'Obsidian', 'Markdown'] },
	{ label: '开发与交付', items: ['Bun', 'npm', 'GitHub Actions', 'VS Code'] },
	{ label: '嵌入式实验', items: ['STM32', 'ESP32', 'Linux', 'LVGL'] },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-body">
		<Header overlay />
		<main class="home" style={`--home-bg: url(${BackgroundImage.src});`}>
			<section class="hero-screen" aria-label="Homepage">
				<div class="tag-field" aria-label="笔记标签">
					{
						tags.map((tag, index) => {
							const label = getShortTagName(tag.name);
							return (
								<button
									class="tag-bubble"
									type="button"
									style={`--size:${Math.min(52 + tag.count * 8, 96)}px; --delay:${index * 0.07}s; --duration:${8.5 + (index % 5) * 0.9}s; --start-x:${7 + (index * 23) % 86}%; --start-y:${9 + (index * 37) % 82}%; --float:${12 + (index % 5) * 5}px; --hue:${185 + (index * 29) % 150};`}
									aria-label={`查看 ${tag.name} 标签下的笔记`}
									title={`#${tag.name}`}
									data-draggable-tag
									data-tag-index={index}
								>
									<span>#{label}</span>
									<small>{tag.count}</small>
								</button>
							);
						})
					}
				</div>

				<section class="welcome" aria-label="Welcome">
					<p>{SITE_TITLE}</p>
					<h1>Welcome</h1>
					<div class="hero-actions">
						<a class="enter-link firefly-button" href={`${baseUrl}blog/`}>进入笔记</a>
						<a class="enter-link ghost" href={`${baseUrl}projects/`}>项目仓库</a>
					</div>
				</section>

				<section class="bio" aria-label="Profile">
					<div class="bio-kicker">Personal Universe</div>
					<p class="name">ZiYyun</p>
					<p class="motto">沉入长期笔记，把代码、系统和日常思考慢慢写清楚。</p>
					<div class="bio-meta">
						<span>{posts.length} notes</span>
						<span>{tags.length} tags</span>
						<span>Astro</span>
					</div>
					<div class="links" aria-label="联系方式">
						<a href="https://github.com/ZiYyyun" target="_blank" rel="noreferrer" aria-label="GitHub">
							<GitBranch size={18} />
						</a>
						<a href="tencent://message/?uin=1583931339&Site=&Menu=yes" aria-label="QQ">
							<span>QQ</span>
						</a>
						<a href={`${baseUrl}about/`} aria-label="WeChat">
							<QrCode size={18} />
						</a>
						<a href="https://t.me/ZiYyyun" target="_blank" rel="noreferrer" aria-label="Telegram">
							<Send size={18} />
						</a>
						<a href="mailto:1583931339@qq.com" aria-label="Email">
							<Mail size={18} />
						</a>
					</div>
				</section>

				<a class="scroll-cue" href="#explore" aria-label="向下浏览">
					<span></span>
				</a>

				<div class="firefly-waves" aria-hidden="true">
					<svg viewBox="0 24 150 28" preserveAspectRatio="none">
						<defs><path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v48h-352z"></path></defs>
						<g>
							<use href="#gentle-wave" x="48" y="0"></use>
							<use href="#gentle-wave" x="48" y="3"></use>
							<use href="#gentle-wave" x="48" y="5"></use>
							<use href="#gentle-wave" x="48" y="7"></use>
						</g>
					</svg>
				</div>
			</section>

			<section id="explore" class="explore-screen" aria-label="个人内容板块">
				<div class="explore-copy">
					<div>
						<p>Explore the universe</p>
						<h2>代码、设备与长期笔记，构成我的数字工作现场。</h2>
					</div>
					<div class="explore-stats" aria-label="站点统计">
						<span><strong>{posts.length}</strong> 篇文章</span>
						<span><strong>{tags.length}</strong> 个标签</span>
						<span><strong>{repos.length}</strong> 个近期仓库</span>
					</div>
				</div>

				<div class="tag-dock" aria-label="标签入口">
					{
						tags.map((tag, tagIndex) => {
							const label = getShortTagName(tag.name);
							return (
								<a class="tag-chip" href={`${baseUrl}tags/${tag.slug}/`} data-tag-chip data-tag-index={tagIndex}>
									<span>#{label}</span>
									<small>{tag.count}</small>
								</a>
							);
						})
					}
				</div>

				<section class="showcase-section repo-showcase" aria-labelledby="repo-title">
					<header class="section-heading">
						<span class="section-icon"><GitBranch size={20} /></span>
						<div>
							<p>Code repositories</p>
							<h2 id="repo-title">代码现场</h2>
							<span>近期维护的仓库、实验项目与站点基础设施。</span>
						</div>
						<a href={`${baseUrl}projects/`}>查看全部 <ArrowUpRight size={16} /></a>
					</header>
					<div class="repo-grid">
						{repos.map((repo) => (
							<a class="repo-tile" href={repo.htmlUrl} target="_blank" rel="noreferrer">
								<div class="repo-topline">
									<Box size={18} />
									<span>{repo.language}</span>
								</div>
								<strong>{repo.name}</strong>
								<p>{repo.description}</p>
								<small><Star size={14} /> {repo.stars}</small>
							</a>
						))}
					</div>
				</section>

				<section class="showcase-section setup-showcase" aria-labelledby="setup-title">
					<header class="section-heading">
						<span class="section-icon warm"><Cpu size={20} /></span>
						<div>
							<p>Workbench & machines</p>
							<h2 id="setup-title">数字工作台</h2>
							<span>写作、构建、嵌入式开发和部署所依赖的环境。</span>
						</div>
						<a href={`${baseUrl}setup/`}>进入展柜 <ArrowUpRight size={16} /></a>
					</header>
					<div class="workbench-grid">
						<div class="terminal-panel">
							<div class="terminal-bar"><i></i><i></i><i></i><span>ziyyun@workbench</span></div>
							<div class="terminal-copy">
								<SquareTerminal size={22} />
								<code>bun run build</code>
								<p>Obsidian → GitHub → Astro → GitHub Pages</p>
							</div>
						</div>
						<div class="tool-groups">
							{toolGroups.map((group) => (
								<div class="tool-group">
									<strong>{group.label}</strong>
									<div>{group.items.map((item) => <span>{item}</span>)}</div>
								</div>
							))}
						</div>
						<a class="machine-tile" href={`${baseUrl}setup/`}>
							<MonitorCog size={24} />
							<div><strong>机器与设备展柜</strong><span>开发机、显示设备、网络与实验平台</span></div>
							<ArrowUpRight size={18} />
						</a>
					</div>
				</section>

				<section class="showcase-section notes-showcase" aria-labelledby="notes-title">
					<header class="section-heading">
						<span class="section-icon green"><BookOpen size={20} /></span>
						<div>
							<p>Articles & notes</p>
							<h2 id="notes-title">长期笔记库</h2>
							<span>从 Obsidian 公开出来的技术实践、系统配置与项目记录。</span>
						</div>
						<a href={`${baseUrl}blog/`}>全部文章 <ArrowUpRight size={16} /></a>
					</header>
					<div class="note-grid">
						{recentPosts.map((post, index) => (
							<a class:list={['note-tile', { featured: index === 0 }]} href={`${baseUrl}blog/${post.id}/`}>
								<div class="note-meta"><FormattedDate date={post.data.pubDate} /><span>{post.data.tags?.[0] ?? 'Note'}</span></div>
								<strong>{post.data.title}</strong>
								<p>{post.data.description}</p>
								<ArrowUpRight size={17} />
							</a>
						))}
					</div>
				</section>

				<footer class="home-footer">
					<span>ZiYyun's Personal Universe</span>
					<span>Built with Astro · Notes from Obsidian</span>
				</footer>
			</section>
		</main>

		<script>
			const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
			const lerp = (a, b, t) => a + (b - a) * t;
			const home = document.querySelector('.home');
			const bubbles = [...document.querySelectorAll('[data-draggable-tag]')];
			const chips = [...document.querySelectorAll('[data-tag-chip]')];
			const bubbleState = new Map();
			let frame = 0;
			let resizeFrame = 0;
			let lastProgress = 0;

			function measure() {
				bubbleState.clear();
				bubbles.forEach((bubble, index) => {
					const target = chips[index];
					if (!target) return;

					const bubbleRect = bubble.getBoundingClientRect();
					const chipRect = target.getBoundingClientRect();
					const style = window.getComputedStyle(bubble);
					const startX = (Number.parseFloat(style.getPropertyValue('--start-x')) / 100) * window.innerWidth;
					const startY = (Number.parseFloat(style.getPropertyValue('--start-y')) / 100) * window.innerHeight;
					bubbleState.set(bubble, {
						drag: null,
						start: {
							left: startX - bubbleRect.width / 2,
							top: startY - bubbleRect.height / 2,
							width: bubbleRect.width,
							height: bubbleRect.height,
						},
						end: {
							left: chipRect.left + window.scrollX,
							top: chipRect.top + window.scrollY,
							width: chipRect.width,
							height: chipRect.height,
						},
					});
					bubble.style.left = '0px';
					bubble.style.top = '0px';
					bubble.style.width = `${bubbleRect.width}px`;
					bubble.style.height = `${bubbleRect.height}px`;
				});
			}

			function render() {
				frame = 0;
				const progress = clamp(window.scrollY / Math.max(window.innerHeight * 0.92, 1), 0, 1);
				lastProgress = progress;
				if (home) {
					home.style.setProperty('--scroll-progress', progress.toFixed(4));
					home.classList.toggle('has-scrolled', progress > 0.84);
				}

				for (const bubble of bubbles) {
					const state = bubbleState.get(bubble);
					if (!state) continue;
					if (bubble.dataset.dragging) continue;

					const targetLeft = state.end.left - window.scrollX;
					const targetTop = state.end.top - window.scrollY;
					const left = lerp(state.start.left, targetLeft, progress);
					const top = lerp(state.start.top, targetTop, progress);
					const width = lerp(state.start.width, state.end.width, progress);
					const height = lerp(state.start.height, state.end.height, progress);
					const scaleX = width / state.start.width;
					const scaleY = height / state.start.height;
					const opacity = lerp(1, 0, Math.max(0, progress - 0.97) / 0.03);

					bubble.style.setProperty('--x', `${left}px`);
					bubble.style.setProperty('--y', `${top}px`);
					bubble.style.setProperty('--scale-x', `${scaleX}`);
					bubble.style.setProperty('--scale-y', `${scaleY}`);
					bubble.style.setProperty('--opacity', `${opacity}`);
					bubble.style.animationPlayState = progress >= 1 ? 'paused' : 'running';
				}
			}

			function scheduleRender() {
				if (frame) return;
				frame = window.requestAnimationFrame(render);
			}

			bubbles.forEach((bubble) => {
				let drag = null;
				const finishDrag = (event) => {
					if (!drag) return;
					if (drag.moved) {
						event?.preventDefault?.();
						const state = bubbleState.get(bubble);
						if (state && Number.isFinite(drag.left) && Number.isFinite(drag.top)) {
							state.start.left = drag.left;
							state.start.top = drag.top;
						}
						bubble.dataset.wasDragged = 'true';
						window.setTimeout(() => delete bubble.dataset.wasDragged, 0);
					}
					delete bubble.dataset.dragging;
					drag = null;
					bubble.classList.remove('is-dragging');
					bubble.style.animationPlayState = lastProgress >= 1 ? 'paused' : 'running';
					scheduleRender();
				};

				bubble.addEventListener('pointerdown', (event) => {
					if (event.button !== 0 || lastProgress > 0.84) return;
					event.preventDefault();
					const rect = bubble.getBoundingClientRect();
					drag = {
						startX: event.clientX,
						startY: event.clientY,
						offsetX: event.clientX - rect.left,
						offsetY: event.clientY - rect.top,
						moved: false,
					};
					const state = bubbleState.get(bubble);
					if (state) state.drag = drag;
					bubble.classList.add('is-dragging');
					bubble.style.animationPlayState = 'paused';
					bubble.setPointerCapture(event.pointerId);
				});

				bubble.addEventListener('pointermove', (event) => {
					if (!drag) return;
					const state = bubbleState.get(bubble);
					const progress = clamp(window.scrollY / Math.max(window.innerHeight * 0.92, 1), 0, 1);
					const width = state.start.width + (state.end.width - state.start.width) * progress;
					const height = state.start.height + (state.end.height - state.start.height) * progress;
					const left = clamp(event.clientX - drag.offsetX, 0, window.innerWidth - width);
					const top = clamp(event.clientY - drag.offsetY, 0, window.innerHeight - height);

					if (Math.abs(event.clientX - drag.startX) + Math.abs(event.clientY - drag.startY) > 6) {
						drag.moved = true;
					}
					drag.left = left;
					drag.top = top;

					bubble.dataset.dragging = 'true';
					bubble.style.setProperty('--x', `${left}px`);
					bubble.style.setProperty('--y', `${top}px`);
				});

				bubble.addEventListener('pointerup', (event) => {
					finishDrag(event);
				});

				bubble.addEventListener('pointercancel', () => {
					finishDrag();
				});

				window.addEventListener('pointerup', (event) => {
					if (drag) finishDrag(event);
				}, { passive: false });
				window.addEventListener('pointercancel', () => finishDrag());
			});

			measure();
			render();
			window.addEventListener('scroll', scheduleRender, { passive: true });
			window.addEventListener('resize', () => {
				if (resizeFrame) return;
				resizeFrame = window.requestAnimationFrame(() => {
					resizeFrame = 0;
					measure();
					render();
				});
			});

			const showcaseSections = document.querySelectorAll('.showcase-section');
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				showcaseSections.forEach((section) => section.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					});
				}, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
				showcaseSections.forEach((section) => observer.observe(section));
			}
		</script>
	</body>
</html>

<style>
	.home-body {
		min-height: 100%;
		overflow-x: hidden;
		background: var(--page-bg);
	}

	.home {
		--scroll-progress: 0;
		position: relative;
		width: 100%;
		max-width: none;
		min-height: 200vh;
		margin: 0;
		padding: 0;
		overflow: clip;
		background:
			linear-gradient(115deg, rgba(22, 56, 48, 0.24), rgba(80, 166, 145, 0.12) 52%, rgba(255, 255, 255, 0.26)),
			var(--home-bg) center / cover fixed no-repeat;
		isolation: isolate;
	}

	.home::before {
		position: fixed;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
			linear-gradient(0deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(120deg, rgba(0, 0, 0, 0.62), transparent 82%);
		content: '';
		pointer-events: none;
	}

	.hero-screen,
	.explore-screen {
		position: relative;
		min-height: 100vh;
	}

	.hero-screen {
		overflow: hidden;
	}

	.firefly-waves {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		z-index: 4;
		height: clamp(7rem, 16vh, 12rem);
		color: oklch(0.965 0.018 165);
		pointer-events: none;
	}

	.firefly-waves svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.firefly-waves use {
		animation: wave-slide 18s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
		fill: currentColor;
	}

	.firefly-waves use:nth-child(1) {
		opacity: 0.28;
		animation-delay: -2s;
		animation-duration: 14s;
	}

	.firefly-waves use:nth-child(2) {
		opacity: 0.42;
		animation-delay: -3s;
		animation-duration: 18s;
	}

	.firefly-waves use:nth-child(3) {
		opacity: 0.62;
		animation-delay: -4s;
		animation-duration: 22s;
	}

	.firefly-waves use:nth-child(4) {
		opacity: 0.95;
		animation-delay: -5s;
		animation-duration: 28s;
	}

	.hero-screen::after {
		position: absolute;
		inset: auto 0 0;
		height: 28vh;
		background: linear-gradient(0deg, rgba(237, 249, 244, 0.82), transparent);
		content: '';
		pointer-events: none;
	}

	.welcome {
		position: fixed;
		left: 50%;
		top: 47%;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.6rem;
		width: min(900px, calc(100% - 2rem));
		color: white;
		text-align: center;
		transform:
			translate(-50%, calc(-50% - var(--scroll-progress) * 120px))
			scale(calc(1 - var(--scroll-progress) * 0.16));
		opacity: calc(1 - var(--scroll-progress) * 0.72);
		pointer-events: none;
		animation: welcome-breathe 5.8s ease-in-out infinite;
		will-change: transform, opacity;
	}

	.welcome p {
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: clamp(0.72rem, 1.4vw, 0.9rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.welcome h1 {
		margin: 0;
		color: rgba(255, 255, 255, 0.94);
		font-size: clamp(4rem, 13vw, 12rem);
		font-weight: 700;
		line-height: 0.86;
		text-shadow:
			0 28px 80px rgba(0, 0, 0, 0.42),
			0 0 42px oklch(0.78 0.13 230 / 0.24);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.2rem;
		pointer-events: auto;
	}

	.enter-link {
		height: 2.6rem;
		padding: 0 1rem;
		color: white;
	}

	.enter-link:hover {
		color: var(--deep-text);
	}

	.enter-link.ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.86);
		text-decoration: none;
		backdrop-filter: blur(16px);
	}

	.enter-link.ghost:hover {
		background: rgba(255, 255, 255, 0.86);
		color: rgb(var(--black));
	}

	.tag-field {
		position: fixed;
		inset: 0;
		z-index: 2;
		pointer-events: auto;
	}

	.tag-bubble {
		position: fixed;
		left: 0;
		top: 0;
		display: inline-grid;
		grid-template-columns: minmax(0, 1fr) auto;
		place-items: center;
		gap: 0;
		width: var(--size);
		height: var(--size);
		padding: 0.3rem;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 999px;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.045)),
			oklch(0.62 0.12 var(--hue) / 0.22);
		color: rgba(255, 255, 255, 0.9);
		font: inherit;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.24),
			0 18px 60px rgba(0, 0, 0, 0.24),
			0 0 34px oklch(0.72 0.14 var(--hue) / 0.18);
		text-align: center;
		text-decoration: none;
		touch-action: none;
		opacity: var(--opacity, 1);
		transform:
			translate3d(var(--x, 0px), var(--y, 0px), 0)
			scale(var(--scale-x, 1), var(--scale-y, 1));
		transform-origin: top left;
		animation:
			bubble-enter 2.2s cubic-bezier(0.18, 0.75, 0.2, 1) both,
			bubble-drift var(--duration) ease-in-out infinite;
		animation-delay: var(--delay), calc(var(--delay) + 1.1s);
		cursor: grab;
		user-select: none;
		-webkit-user-drag: none;
		contain: layout style paint;
		will-change: transform, opacity;
	}

	.tag-bubble::before {
		position: absolute;
		inset: 10%;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: inherit;
		content: '';
		pointer-events: none;
	}

	.tag-bubble::after {
		position: absolute;
		left: 22%;
		top: 17%;
		width: 24%;
		height: 18%;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.32);
		filter: blur(1px);
		content: '';
		pointer-events: none;
		animation: bubble-glint 4.8s ease-in-out infinite;
		animation-delay: calc(var(--delay) + 1.4s);
	}

	.tag-bubble span {
		max-width: 100%;
		min-width: 0;
		font-size: 0.64rem;
		font-weight: 800;
		line-height: 1.16;
		overflow-wrap: anywhere;
		text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
	}

	.tag-bubble small {
		display: none;
	}

	.tag-bubble:hover,
	.tag-bubble.is-dragging {
		z-index: 4;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.36), rgba(255, 255, 255, 0.1)),
			oklch(0.78 0.08 var(--hue) / 0.36);
		color: white;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.35),
			0 28px 80px rgba(0, 0, 0, 0.34),
			0 0 44px oklch(0.78 0.16 var(--hue) / 0.28);
	}

	.tag-dock {
		position: relative;
		z-index: 8;
	}

	.home.has-scrolled .tag-chip {
		opacity: clamp(0, calc((var(--scroll-progress) - 0.84) * 6.25), 1);
		pointer-events: auto;
	}

	.tag-bubble.is-dragging {
		cursor: grabbing;
		animation-play-state: paused;
	}

	.bio {
		position: fixed;
		left: clamp(1rem, 4vw, 3rem);
		bottom: clamp(1rem, 4vw, 3rem);
		z-index: 3;
		width: min(410px, calc(100% - 2rem));
		border: 1px solid rgba(255, 255, 255, 0.76);
		border-radius: 1.25rem;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(236, 250, 244, 0.76)),
			rgba(255, 255, 255, 0.72);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.18),
			0 24px 80px rgba(0, 0, 0, 0.32);
		padding: 1rem;
		color: oklch(0.28 0.024 165);
		transform: translateY(calc(var(--scroll-progress) * 85px));
		opacity: calc(1 - var(--scroll-progress) * 0.8);
		transition: border-color 160ms ease, background 160ms ease;
	}

	.bio::before {
		position: absolute;
		inset: 0.65rem;
		z-index: -1;
		border-radius: 0.95rem;
		background: linear-gradient(135deg, oklch(0.78 0.14 245 / 0.12), transparent 62%);
		content: '';
	}

	.bio-kicker {
		width: fit-content;
		margin-bottom: 0.65rem;
		border-radius: 999px;
		background: oklch(0.9 0.08 165);
		padding: 0.2rem 0.58rem;
		color: oklch(0.48 0.12 165);
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.name,
	.motto {
		margin: 0;
	}

	.name {
		color: oklch(0.22 0.03 165);
		font-size: 1.35rem;
		font-weight: 800;
	}

	.motto {
		max-width: 340px;
		margin-top: 0.42rem;
		color: oklch(0.43 0.025 165);
		font-size: 0.92rem;
		line-height: 1.78;
	}

	.bio-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.9rem;
	}

	.bio-meta span {
		border: 1px solid rgba(50, 150, 120, 0.12);
		border-radius: 999px;
		background: oklch(0.93 0.055 165);
		padding: 0.18rem 0.5rem;
		color: oklch(0.48 0.1 165);
		font-size: 0.72rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 1rem;
	}

	.links a {
		display: inline-grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(50, 150, 120, 0.14);
		border-radius: 0.86rem;
		background: oklch(0.92 0.06 165);
		color: oklch(0.48 0.12 165);
		text-decoration: none;
		backdrop-filter: blur(14px);
		transition: transform 160ms ease, background 160ms ease, color 160ms ease;
	}

	.links a span {
		font-size: 0.67rem;
		font-weight: 900;
	}

	.links a:hover {
		background: var(--primary);
		color: white;
		transform: translateY(-2px);
	}

	.scroll-cue {
		position: absolute;
		right: clamp(1rem, 3vw, 2rem);
		top: 50%;
		z-index: 5;
		display: grid;
		place-items: center;
		width: 34px;
		height: 54px;
		border: 1px solid rgba(255, 255, 255, 0.26);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		transform: translateY(-50%);
		backdrop-filter: blur(12px);
	}

	.scroll-cue span {
		width: 5px;
		height: 10px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.76);
		animation: cue 1.8s ease-in-out infinite;
	}

	.explore-screen {
		z-index: 6;
		display: grid;
		align-content: start;
		gap: clamp(3.5rem, 7vw, 6rem);
		padding: clamp(5rem, 9vw, 8rem) clamp(1rem, 5vw, 5rem) 2rem;
		background:
			linear-gradient(180deg, rgba(14, 14, 22, 0.72), rgba(18, 18, 28, 0.97) 19rem, rgba(244, 245, 249, 0.98) 44rem);
	}

	.explore-copy {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		width: min(1180px, 100%);
		margin: 0 auto;
		color: white;
	}

	.explore-copy p {
		margin: 0 0 0.5rem;
		color: oklch(0.84 0.09 245);
		font-size: 0.78rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.explore-copy h2 {
		max-width: 760px;
		margin: 0;
		color: rgba(255, 255, 255, 0.92);
		font-size: clamp(2rem, 4vw, 4.2rem);
		line-height: 1.06;
	}

	.explore-stats {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.55rem;
		max-width: 330px;
	}

	.explore-stats span {
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		padding: 0.38rem 0.7rem;
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.74rem;
	}

	.explore-stats strong {
		color: white;
	}

	.tag-dock {
		width: min(1180px, 100%);
		margin: 0 auto;
	}

	.tag-dock {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.tag-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: 1px solid rgba(24, 24, 34, 0.1);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		box-shadow: 0 12px 34px rgba(17, 17, 25, 0.08);
		padding: 0.56rem 0.72rem;
		color: rgb(var(--black));
		text-decoration: none;
		opacity: 0;
		pointer-events: none;
		transition: transform 180ms ease, background 180ms ease, opacity 120ms linear;
	}

	.tag-chip:hover {
		background: white;
		transform: translateY(-2px);
	}

	.tag-chip span {
		font-size: 0.84rem;
		font-weight: 800;
	}

	.tag-chip small {
		display: grid;
		place-items: center;
		min-width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		background: oklch(0.9 0.06 245);
		color: oklch(0.46 0.14 250);
		font-size: 0.72rem;
		font-weight: 900;
	}

	.showcase-section,
	.home-footer {
		width: min(1180px, 100%);
		margin: 0 auto;
	}

	.showcase-section {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity 650ms ease, transform 650ms cubic-bezier(0.2, 0.75, 0.2, 1);
	}

	.showcase-section.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.section-heading {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 1.35rem;
	}

	.section-icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 8px;
		background: oklch(0.9 0.06 250);
		color: oklch(0.5 0.15 250);
	}

	.section-icon.warm {
		background: oklch(0.92 0.07 70);
		color: oklch(0.55 0.15 45);
	}

	.section-icon.green {
		background: oklch(0.91 0.07 160);
		color: oklch(0.48 0.12 160);
	}

	.section-heading p,
	.section-heading h2,
	.section-heading span {
		margin: 0;
	}

	.section-heading p {
		color: var(--primary);
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.section-heading h2 {
		margin-top: 0.1rem;
		font-size: clamp(1.65rem, 3vw, 2.35rem);
	}

	.section-heading div > span {
		display: block;
		margin-top: 0.18rem;
		color: rgb(var(--gray));
		font-size: 0.86rem;
	}

	.section-heading > a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		border-bottom: 1px solid rgba(var(--gray), 0.3);
		padding: 0.35rem 0;
		color: rgb(var(--gray-dark));
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}

	.section-heading > a:hover {
		border-color: var(--primary);
		color: var(--primary);
	}

	.repo-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.repo-tile {
		position: relative;
		display: grid;
		gap: 0.65rem;
		min-height: 180px;
		border: 1px solid rgba(25, 27, 38, 0.09);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.86);
		box-shadow: 0 16px 48px rgba(28, 30, 44, 0.08);
		padding: 1.15rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.repo-tile:hover {
		border-color: oklch(0.72 0.12 250 / 0.5);
		box-shadow: 0 22px 60px rgba(28, 30, 44, 0.13);
		transform: translateY(-3px);
	}

	.repo-topline,
	.repo-tile small {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.repo-topline {
		justify-content: space-between;
		color: var(--primary);
	}

	.repo-topline span {
		border-radius: 999px;
		background: var(--btn-regular-bg);
		padding: 0.18rem 0.5rem;
		font-size: 0.7rem;
	}

	.repo-tile > strong {
		font-size: 1.05rem;
		overflow-wrap: anywhere;
	}

	.repo-tile p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.84rem;
		line-height: 1.65;
	}

	.repo-tile small {
		align-self: end;
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	.workbench-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: 0.8rem;
	}

	.terminal-panel {
		min-height: 260px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 8px;
		background: #1c1d24;
		box-shadow: 0 20px 60px rgba(24, 25, 34, 0.16);
		color: rgba(255, 255, 255, 0.86);
		overflow: hidden;
	}

	.terminal-bar {
		display: flex;
		align-items: center;
		gap: 0.38rem;
		height: 42px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding: 0 0.85rem;
	}

	.terminal-bar i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ef6a67;
	}

	.terminal-bar i:nth-child(2) { background: #e6b95c; }
	.terminal-bar i:nth-child(3) { background: #63c174; }

	.terminal-bar span {
		margin-left: auto;
		color: rgba(255, 255, 255, 0.42);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.68rem;
	}

	.terminal-copy {
		display: grid;
		align-content: center;
		gap: 1rem;
		height: calc(100% - 42px);
		padding: 1.5rem;
	}

	.terminal-copy svg { color: oklch(0.78 0.13 170); }

	.terminal-copy code {
		width: fit-content;
		background: rgba(255, 255, 255, 0.08);
		color: oklch(0.84 0.1 160);
		font-size: clamp(1rem, 2vw, 1.35rem);
	}

	.terminal-copy p {
		margin: 0;
		color: rgba(255, 255, 255, 0.56);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.76rem;
	}

	.tool-groups {
		display: grid;
		gap: 0.8rem;
	}

	.tool-group {
		border: 1px solid rgba(25, 27, 38, 0.09);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.82);
		padding: 0.85rem;
	}

	.tool-group > strong {
		display: block;
		margin-bottom: 0.55rem;
		font-size: 0.8rem;
	}

	.tool-group > div {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.tool-group span {
		border-radius: 5px;
		background: var(--btn-regular-bg);
		padding: 0.18rem 0.45rem;
		color: var(--btn-content);
		font-size: 0.7rem;
	}

	.machine-tile {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.9rem;
		border: 1px solid rgba(25, 27, 38, 0.09);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.84);
		padding: 1rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}

	.machine-tile > svg:first-child { color: oklch(0.55 0.15 45); }
	.machine-tile > svg:last-child { color: rgb(var(--gray)); }
	.machine-tile div { display: grid; gap: 0.12rem; }
	.machine-tile span { color: rgb(var(--gray)); font-size: 0.78rem; }

	.note-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
	}

	.note-tile {
		position: relative;
		display: grid;
		align-content: start;
		gap: 0.65rem;
		min-height: 190px;
		border: 1px solid rgba(25, 27, 38, 0.09);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.84);
		padding: 1.1rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: border-color 180ms ease, transform 180ms ease;
	}

	.note-tile:hover {
		border-color: oklch(0.68 0.12 160 / 0.5);
		transform: translateY(-3px);
	}

	.note-tile.featured {
		background: linear-gradient(135deg, oklch(0.94 0.04 160), rgba(255, 255, 255, 0.9));
	}

	.note-meta {
		display: flex;
		justify-content: space-between;
		gap: 0.6rem;
		color: rgb(var(--gray));
		font-size: 0.7rem;
	}

	.note-meta span {
		max-width: 48%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.note-tile > strong {
		font-size: 1.03rem;
		line-height: 1.45;
	}

	.note-tile p {
		display: -webkit-box;
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.82rem;
		line-height: 1.68;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.note-tile > svg {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		color: var(--primary);
	}

	.home-footer {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid rgba(25, 27, 38, 0.1);
		padding-top: 1.2rem;
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	@keyframes bubble-enter {
		0% {
			filter: blur(7px);
		}
		55% {
			filter: blur(2.5px);
		}
		100% {
			filter: blur(0);
		}
	}

	@keyframes bubble-drift {
		0%, 100% { translate: 0 0; rotate: -1.5deg; }
		32% { translate: calc(var(--float) * 0.45) calc(var(--float) * -0.65); rotate: 2deg; }
		68% { translate: calc(var(--float) * -0.35) calc(var(--float) * 0.42); rotate: -2.5deg; }
	}

	@keyframes bubble-glint {
		0%, 100% { opacity: 0.28; translate: 0 0; }
		50% { opacity: 0.62; translate: 18% 10%; }
	}

	@keyframes welcome-breathe {
		0%,
		100% {
			translate: 0 -3px;
		}
		50% {
			translate: 0 5px;
		}
	}

	@keyframes cue {
		0%,
		100% {
			opacity: 0.35;
			transform: translateY(-6px);
		}
		50% {
			opacity: 1;
			transform: translateY(8px);
		}
	}

	@keyframes wave-slide {
		0% {
			transform: translate3d(-90px, 0, 0);
		}
		100% {
			transform: translate3d(85px, 0, 0);
		}
	}

	@media (max-width: 820px) {
		.welcome {
			top: 38%;
		}

		.bio {
			left: 1rem;
			right: 1rem;
			bottom: 1rem;
			width: auto;
		}

		.explore-copy {
			align-items: start;
			flex-direction: column;
		}

		.explore-stats {
			justify-content: flex-start;
		}

		.workbench-grid {
			grid-template-columns: 1fr;
		}

		.machine-tile {
			grid-column: auto;
		}

		.explore-copy h2 {
			font-size: clamp(2rem, 10vw, 3rem);
		}
	}

	@media (max-width: 560px) {
		.tag-bubble {
			width: calc(var(--size) * 0.84);
			height: calc(var(--size) * 0.84);
		}

		.welcome h1 {
			font-size: clamp(3.5rem, 20vw, 6rem);
		}

		.hero-actions {
			margin-top: 0.8rem;
		}

		.explore-screen {
			gap: 3.5rem;
			padding-inline: 0.85rem;
		}

		.repo-grid,
		.note-grid {
			grid-template-columns: 1fr;
		}

		.section-heading {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.section-heading > a {
			grid-column: 2;
			width: fit-content;
		}

		.home-footer {
			flex-direction: column;
		}
