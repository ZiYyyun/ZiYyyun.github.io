---
import { Code, Mail, MessageCircle, Rss } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BackgroundImage from '../assets/fuwari-banner.png';
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getTagSummaries } from '../lib/tags';

const posts = await getCollection('blog');
const baseUrl = import.meta.env.BASE_URL;
const tags = getTagSummaries(posts, baseUrl);

function getShortTagName(name: string) {
	const parts = name.split(/[\\/]/).filter(Boolean);
	return parts.at(-1) ?? name;
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-body">
		<main class="home" style={`--home-bg: url(${BackgroundImage.src});`}>
			<div class="tag-field" aria-label="笔记标签">
				{
					tags.map((tag, index) => {
						const label = getShortTagName(tag.name);
						return (
							<a
								class="tag-bubble"
								href={`${baseUrl}tags/${tag.slug}/`}
								style={`--size:${Math.min(46 + tag.count * 7, 84)}px; --delay:${index * -0.82}s; --x:${6 + (index * 23) % 88}%; --y:${7 + (index * 37) % 86}%; --float:${12 + (index % 5) * 4}px;`}
								aria-label={`查看 ${tag.name} 标签下的笔记`}
								title={`#${tag.name}`}
							>
								<span>#{label}</span>
							</a>
						);
					})
				}
			</div>

			<section class="welcome" aria-label="Welcome">
				<p>{SITE_TITLE}</p>
				<h1>Welcome</h1>
				<div class="hero-actions">
					<a class="enter-link fuwari-button" href={`${baseUrl}blog/`}>进入笔记</a>
					<a class="enter-link ghost" href={`${baseUrl}projects/`}>项目仓库</a>
				</div>
			</section>

			<section class="bio" aria-label="Profile">
				<div class="bio-kicker">Personal Universe</div>
				<p class="name">ZiYyun</p>
				<p class="motto">沉入长期笔记，把代码、系统和日常思考慢慢写清楚。</p>
				<div class="bio-meta">
					<span>{posts.length} notes</span>
					<span>{tags.length} tags</span>
					<span>Astro</span>
				</div>
				<div class="links" aria-label="个人链接">
					<a href="https://github.com/ZiYyyun" target="_blank" rel="noreferrer" aria-label="GitHub">
						<Code size={18} />
					</a>
					<a href="mailto:1583931339@qq.com" aria-label="Email">
						<Mail size={18} />
					</a>
					<a href={`${baseUrl}rss.xml`} aria-label="RSS">
						<Rss size={18} />
					</a>
					<a href={`${baseUrl}about/`} aria-label="About">
						<MessageCircle size={18} />
					</a>
				</div>
			</section>
		</main>
	</body>
</html>

<style>
	.home-body {
		overflow: hidden;
		background: #15151e;
	}

	.home {
		position: relative;
		width: 100%;
		max-width: none;
		min-height: 100vh;
		margin: 0;
		padding: 0;
		overflow: hidden;
		background:
			linear-gradient(115deg, rgba(15, 15, 24, 0.93), rgba(27, 25, 46, 0.52) 52%, rgba(80, 74, 128, 0.16)),
			var(--home-bg) center / cover no-repeat;
		isolation: isolate;
	}

	.home::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(circle at 28% 38%, oklch(0.75 0.16 285 / 0.14), transparent 28rem),
			radial-gradient(circle at 75% 65%, oklch(0.78 0.13 185 / 0.11), transparent 24rem),
			linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
			linear-gradient(0deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
		background-size: auto, auto, 72px 72px, 72px 72px;
		mask-image: linear-gradient(120deg, rgba(0, 0, 0, 0.9), transparent 82%);
		content: '';
	}

	.home::after {
		position: absolute;
		inset: auto 0 0;
		height: 42vh;
		background: linear-gradient(0deg, rgba(10, 10, 18, 0.82), transparent);
		content: '';
		pointer-events: none;
	}

	.welcome {
		position: absolute;
		left: 50%;
		top: 47%;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.6rem;
		width: min(900px, calc(100% - 2rem));
		color: white;
		text-align: center;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.welcome p {
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: clamp(0.72rem, 1.4vw, 0.9rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.welcome h1 {
		margin: 0;
		color: rgba(255, 255, 255, 0.94);
		font-size: clamp(4rem, 13vw, 12rem);
		font-weight: 700;
		line-height: 0.86;
		text-shadow: 0 28px 80px rgba(0, 0, 0, 0.42);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.2rem;
		pointer-events: auto;
	}

	.enter-link {
		height: 2.6rem;
		padding: 0 1rem;
		color: white;
	}

	.enter-link:hover {
		color: var(--deep-text);
	}

	.enter-link.ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.86);
		text-decoration: none;
		backdrop-filter: blur(16px);
	}

	.enter-link.ghost:hover {
		background: rgba(255, 255, 255, 0.86);
		color: rgb(var(--black));
	}

	.tag-field {
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.tag-bubble {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: grid;
		place-items: center;
		width: var(--size);
		height: var(--size);
		padding: 0.3rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 50%;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.045)),
			oklch(0.62 0.08 250 / 0.16);
		color: rgba(255, 255, 255, 0.88);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.22),
			0 18px 60px rgba(0, 0, 0, 0.22),
			0 0 28px oklch(0.72 0.14 var(--hue) / 0.12);
		text-align: center;
		text-decoration: none;
		backdrop-filter: blur(18px) saturate(1.3);
		transform: translate(-50%, -50%);
		animation: drift 12s ease-in-out infinite;
		animation-delay: var(--delay);
	}

	.tag-bubble::before {
		position: absolute;
		inset: 10%;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: inherit;
		content: '';
		pointer-events: none;
	}

	.tag-bubble:nth-child(3n) {
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.04)),
			oklch(0.58 0.14 315 / 0.17);
	}

	.tag-bubble:nth-child(4n) {
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.04)),
			oklch(0.6 0.12 190 / 0.16);
	}

	.tag-bubble span {
		max-width: 100%;
		font-size: clamp(0.52rem, 0.7vw, 0.72rem);
		font-weight: 700;
		line-height: 1.16;
		overflow-wrap: anywhere;
		text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
	}

	.tag-bubble:hover {
		background: rgba(255, 255, 255, 0.86);
		color: rgb(var(--black));
		transform: translate(-50%, -50%) scale(1.08);
	}

	.tag-bubble:hover span {
		text-shadow: none;
	}

	.bio {
		position: absolute;
		left: clamp(1rem, 4vw, 3rem);
		bottom: clamp(1rem, 4vw, 3rem);
		z-index: 3;
		width: min(390px, calc(100% - 2rem));
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 1.1rem;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.06)),
			rgba(18, 18, 27, 0.34);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.16),
			0 24px 80px rgba(0, 0, 0, 0.32);
		padding: 1rem;
		color: white;
		backdrop-filter: blur(18px) saturate(1.2);
	}

	.bio-kicker {
		width: fit-content;
		margin-bottom: 0.65rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.12);
		padding: 0.2rem 0.58rem;
		color: rgba(255, 255, 255, 0.68);
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.name,
	.motto {
		margin: 0;
	}

	.name {
		font-size: 1.25rem;
		font-weight: 700;
	}

	.motto {
		max-width: 330px;
		margin-top: 0.38rem;
		color: rgba(255, 255, 255, 0.74);
		font-size: 0.9rem;
		line-height: 1.72;
	}

	.bio-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.85rem;
	}

	.bio-meta span {
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		padding: 0.18rem 0.5rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.72rem;
	}

	.links {
		display: flex;
		gap: 0.55rem;
		margin-top: 1rem;
	}

	.links a {
		display: inline-grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.8rem;
		background: rgba(255, 255, 255, 0.1);
		color: white;
		backdrop-filter: blur(14px);
	}

	.links a:hover {
		background: rgba(255, 255, 255, 0.88);
		color: rgb(var(--black));
	}

	@keyframes drift {
		0%,
		100% {
			transform: translate(-50%, -50%);
		}
		50% {
			transform: translate(calc(-50% + var(--float)), calc(-50% - var(--float)));
		}
	}

	@media (max-width: 720px) {
		.home-body {
			overflow: auto;
		}

		.home {
			min-height: 100vh;
		}
	}
</style>
