---
import { Code, Mail, MessageCircle, Rss } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BackgroundImage from '../assets/blog-placeholder-about.jpg';
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getTagSummaries } from '../lib/tags';

const posts = await getCollection('blog');
const baseUrl = import.meta.env.BASE_URL;
const tags = getTagSummaries(posts, baseUrl);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main class="home" style={`--home-bg: url(${BackgroundImage.src});`}>
			<div class="tag-field" aria-label="笔记标签">
				{
					tags.map((tag, index) => (
						<a
							class="tag-bubble"
							href={`${baseUrl}tags/${tag.slug}/`}
							style={`--size:${Math.min(38 + tag.count * 7, 72)}px; --delay:${index * -0.75}s; --x:${7 + (index * 19) % 86}%; --y:${8 + (index * 31) % 84}%;`}
							aria-label={`查看 ${tag.name} 标签下的笔记`}
						>
							<span>#{tag.name}</span>
						</a>
					))
				}
			</div>

			<h1>Welcome</h1>

			<div class="bio">
				<p class="name">ZiYyun</p>
				<p class="motto">嵌入式、代码与长期笔记。</p>
				<div class="links" aria-label="个人链接">
					<a href="https://github.com/ZiYyyun" target="_blank" aria-label="GitHub">
						<Code size={18} />
					</a>
					<a href="mailto:1583931339@qq.com" aria-label="Email">
						<Mail size={18} />
					</a>
					<a href={`${baseUrl}rss.xml`} aria-label="RSS">
						<Rss size={18} />
					</a>
					<a href={`${baseUrl}about/`} aria-label="About">
						<MessageCircle size={18} />
					</a>
				</div>
			</div>
		</main>
	</body>
</html>

<style>
	body {
		overflow: hidden;
	}

	.home {
		position: relative;
		width: 100%;
		max-width: none;
		min-height: 100vh;
		margin: 0;
		padding: 0;
		overflow: hidden;
		background:
			linear-gradient(90deg, rgba(250, 251, 252, 0.84), rgba(250, 251, 252, 0.45)),
			var(--home-bg) center / cover no-repeat;
	}

	.home h1 {
		position: absolute;
		left: 50%;
		top: 49%;
		z-index: 1;
		margin: 0;
		color: rgba(var(--black), 0.86);
		font-size: clamp(3.5rem, 13vw, 11rem);
		font-weight: 700;
		line-height: 0.9;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}

	.tag-field {
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.tag-bubble {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: grid;
		place-items: center;
		width: var(--size);
		height: var(--size);
		padding: 0.25rem;
		border: 1px solid rgba(var(--black), 0.12);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.62);
		color: rgb(var(--black));
		box-shadow: 0 16px 42px rgba(var(--gray), 18%);
		text-align: center;
		text-decoration: none;
		backdrop-filter: blur(12px);
		transform: translate(-50%, -50%);
		animation: drift 11s ease-in-out infinite;
		animation-delay: var(--delay);
	}

	.tag-bubble span {
		max-width: 100%;
		font-size: clamp(0.48rem, 0.68vw, 0.68rem);
		line-height: 1.08;
		overflow-wrap: anywhere;
	}

	.tag-bubble:hover {
		background: rgba(var(--black), 0.9);
		color: white;
	}

	.bio {
		position: absolute;
		left: clamp(1rem, 4vw, 3rem);
		bottom: clamp(1rem, 4vw, 3rem);
		z-index: 3;
		width: min(360px, calc(100% - 2rem));
		padding: 1rem;
		border: 1px solid rgba(var(--black), 0.1);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.68);
		box-shadow: 0 18px 56px rgba(var(--gray), 18%);
		backdrop-filter: blur(18px);
	}

	.name,
	.motto {
		margin: 0;
	}

	.name {
		color: rgb(var(--black));
		font-size: 1.05rem;
		font-weight: 700;
	}

	.motto {
		margin-top: 0.25rem;
		color: rgb(var(--gray-dark));
		font-size: 0.86rem;
	}

	.links {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.9rem;
	}

	.links a {
		display: inline-grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border: 1px solid rgba(var(--black), 0.12);
		border-radius: 50%;
		background: white;
		color: rgb(var(--black));
	}

	.links a:hover {
		background: rgb(var(--black));
		color: white;
	}

	@keyframes drift {
		0%,
		100% {
			transform: translate(-50%, -50%);
		}
		50% {
			transform: translate(calc(-50% + 18px), calc(-50% - 16px));
		}
	}

	@media (max-width: 720px) {
		body {
			overflow: auto;
		}

		.home {
			min-height: 100vh;
		}
	}
</style>
