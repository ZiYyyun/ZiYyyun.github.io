---
import { GitBranch, Mail, MonitorCog, QrCode, Send, SquareTerminal } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BackgroundImage from '../assets/fuwari-banner.png';
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getTagSummaries } from '../lib/tags';

const posts = await getCollection('blog');
const baseUrl = import.meta.env.BASE_URL;
const tags = getTagSummaries(posts, baseUrl);

function getShortTagName(name: string) {
	const parts = name.split(/[\\/]/).filter(Boolean);
	return parts.at(-1) ?? name;
}

const quickEntries = [
	{
		title: '笔记宇宙',
		description: '从 Obsidian 发布出来的长期笔记、嵌入式实践和开发记录。',
		href: `${baseUrl}blog/`,
		icon: SquareTerminal,
	},
	{
		title: '项目仓库',
		description: 'GitHub 项目、实验代码和正在慢慢打磨的工具集合。',
		href: `${baseUrl}projects/`,
		icon: GitBranch,
	},
	{
		title: '开发环境',
		description: '系统、编辑器、工具链、工作流和常用软件配置。',
		href: `${baseUrl}setup/`,
		icon: MonitorCog,
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="home-body">
		<main class="home" style={`--home-bg: url(${BackgroundImage.src});`}>
			<section class="hero-screen" aria-label="Homepage">
				<div class="tag-field" aria-label="笔记标签">
					{
						tags.map((tag, index) => {
							const label = getShortTagName(tag.name);
							return (
								<a
									class="tag-bubble"
									href={`${baseUrl}tags/${tag.slug}/`}
									style={`--size:${Math.min(52 + tag.count * 8, 96)}px; --delay:${index * 0.09}s; --x:${7 + (index * 23) % 86}%; --y:${9 + (index * 37) % 82}%; --float:${12 + (index % 5) * 5}px; --hue:${185 + (index * 29) % 150};`}
									aria-label={`查看 ${tag.name} 标签下的笔记`}
									title={`#${tag.name}`}
									data-draggable-tag
								>
									<span>#{label}</span>
								</a>
							);
						})
					}
				</div>

				<section class="welcome" aria-label="Welcome">
					<p>{SITE_TITLE}</p>
					<h1>Welcome</h1>
					<div class="hero-actions">
						<a class="enter-link fuwari-button" href={`${baseUrl}blog/`}>进入笔记</a>
						<a class="enter-link ghost" href={`${baseUrl}projects/`}>项目仓库</a>
					</div>
				</section>

				<section class="bio" aria-label="Profile">
					<div class="bio-kicker">Personal Universe</div>
					<p class="name">ZiYyun</p>
					<p class="motto">沉入长期笔记，把代码、系统和日常思考慢慢写清楚。</p>
					<div class="bio-meta">
						<span>{posts.length} notes</span>
						<span>{tags.length} tags</span>
						<span>Astro</span>
					</div>
					<div class="links" aria-label="联系方式">
						<a href="https://github.com/ZiYyyun" target="_blank" rel="noreferrer" aria-label="GitHub">
							<GitBranch size={18} />
						</a>
						<a href="tencent://message/?uin=1583931339&Site=&Menu=yes" aria-label="QQ">
							<span>QQ</span>
						</a>
						<a href={`${baseUrl}about/`} aria-label="WeChat">
							<QrCode size={18} />
						</a>
						<a href="https://t.me/ZiYyyun" target="_blank" rel="noreferrer" aria-label="Telegram">
							<Send size={18} />
						</a>
						<a href="mailto:1583931339@qq.com" aria-label="Email">
							<Mail size={18} />
						</a>
					</div>
				</section>

				<a class="scroll-cue" href="#explore" aria-label="向下浏览">
					<span></span>
				</a>
			</section>

			<section id="explore" class="explore-screen" aria-label="入口板块">
				<div class="explore-copy">
					<p>Explore</p>
					<h2>把散落的记录整理成可以进入的房间。</h2>
				</div>

				<div class="entry-grid">
					{
						quickEntries.map((entry) => {
							const Icon = entry.icon;
							return (
								<a class="entry-card" href={entry.href}>
									<span class="entry-icon">
										<Icon size={22} />
									</span>
									<strong>{entry.title}</strong>
									<small>{entry.description}</small>
								</a>
							);
						})
					}
				</div>

				<div class="tag-dock" aria-label="标签入口">
					{
						tags.map((tag) => {
							const label = getShortTagName(tag.name);
							return (
								<a class="tag-chip" href={`${baseUrl}tags/${tag.slug}/`}>
									<span>#{label}</span>
									<small>{tag.count}</small>
								</a>
							);
						})
					}
				</div>
			</section>
		</main>

		<script>
			const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
			const home = document.querySelector('.home');
			const bubbles = [...document.querySelectorAll('[data-draggable-tag]')];

			bubbles.forEach((bubble) => {
				let drag = null;

				bubble.addEventListener('pointerdown', (event) => {
					if (event.button !== 0) return;
					const rect = bubble.getBoundingClientRect();
					drag = {
						startX: event.clientX,
						startY: event.clientY,
						offsetX: event.clientX - rect.left,
						offsetY: event.clientY - rect.top,
						moved: false,
					};
					bubble.classList.add('is-dragging');
					bubble.setPointerCapture(event.pointerId);
				});

				bubble.addEventListener('pointermove', (event) => {
					if (!drag) return;
					const field = bubble.parentElement.getBoundingClientRect();
					const size = bubble.getBoundingClientRect().width;
					const left = clamp(event.clientX - field.left - drag.offsetX + size / 2, size / 2, field.width - size / 2);
					const top = clamp(event.clientY - field.top - drag.offsetY + size / 2, size / 2, field.height - size / 2);

					if (Math.abs(event.clientX - drag.startX) + Math.abs(event.clientY - drag.startY) > 6) {
						drag.moved = true;
					}

					bubble.style.setProperty('--x', `${(left / field.width) * 100}%`);
					bubble.style.setProperty('--y', `${(top / field.height) * 100}%`);
				});

				bubble.addEventListener('pointerup', (event) => {
					if (drag?.moved) {
						event.preventDefault();
						bubble.dataset.wasDragged = 'true';
						window.setTimeout(() => delete bubble.dataset.wasDragged, 0);
					}
					drag = null;
					bubble.classList.remove('is-dragging');
				});

				bubble.addEventListener('click', (event) => {
					if (bubble.dataset.wasDragged) event.preventDefault();
				});
			});

			const updateScrollState = () => {
				if (!home) return;
				const progress = clamp(window.scrollY / Math.max(window.innerHeight * 0.72, 1), 0, 1);
				home.style.setProperty('--scroll-progress', progress.toFixed(3));
				home.classList.toggle('has-scrolled', progress > 0.42);
			};

			updateScrollState();
			window.addEventListener('scroll', updateScrollState, { passive: true });
		</script>
	</body>
</html>

<style>
	.home-body {
		min-height: 100%;
		overflow-x: hidden;
		background: #15151e;
	}

	.home {
		--scroll-progress: 0;
		position: relative;
		width: 100%;
		max-width: none;
		min-height: 200vh;
		margin: 0;
		padding: 0;
		overflow: clip;
		background:
			linear-gradient(115deg, rgba(15, 15, 24, 0.93), rgba(27, 25, 46, 0.58) 52%, rgba(80, 74, 128, 0.18)),
			var(--home-bg) center / cover fixed no-repeat;
		isolation: isolate;
	}

	.home::before {
		position: fixed;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(circle at 28% 38%, oklch(0.75 0.16 285 / 0.16), transparent 28rem),
			radial-gradient(circle at 75% 65%, oklch(0.78 0.13 185 / 0.12), transparent 24rem),
			linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px),
			linear-gradient(0deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
		background-size: auto, auto, 72px 72px, 72px 72px;
		mask-image: linear-gradient(120deg, rgba(0, 0, 0, 0.9), transparent 82%);
		content: '';
		pointer-events: none;
	}

	.hero-screen,
	.explore-screen {
		position: relative;
		min-height: 100vh;
	}

	.hero-screen {
		overflow: hidden;
	}

	.hero-screen::after {
		position: absolute;
		inset: auto 0 0;
		height: 42vh;
		background: linear-gradient(0deg, rgba(10, 10, 18, 0.86), transparent);
		content: '';
		pointer-events: none;
	}

	.welcome {
		position: fixed;
		left: 50%;
		top: 47%;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.6rem;
		width: min(900px, calc(100% - 2rem));
		color: white;
		text-align: center;
		transform:
			translate(-50%, calc(-50% - var(--scroll-progress) * 120px))
			scale(calc(1 - var(--scroll-progress) * 0.16));
		opacity: calc(1 - var(--scroll-progress) * 0.72);
		pointer-events: none;
		animation: welcome-breathe 5.8s ease-in-out infinite;
		will-change: transform, opacity;
	}

	.welcome p {
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: clamp(0.72rem, 1.4vw, 0.9rem);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.welcome h1 {
		margin: 0;
		color: rgba(255, 255, 255, 0.94);
		font-size: clamp(4rem, 13vw, 12rem);
		font-weight: 700;
		line-height: 0.86;
		text-shadow:
			0 28px 80px rgba(0, 0, 0, 0.42),
			0 0 42px oklch(0.78 0.13 230 / 0.24);
		animation: welcome-glow 6.5s ease-in-out infinite;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.2rem;
		pointer-events: auto;
	}

	.enter-link {
		height: 2.6rem;
		padding: 0 1rem;
		color: white;
	}

	.enter-link:hover {
		color: var(--deep-text);
	}

	.enter-link.ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.86);
		text-decoration: none;
		backdrop-filter: blur(16px);
	}

	.enter-link.ghost:hover {
		background: rgba(255, 255, 255, 0.86);
		color: rgb(var(--black));
	}

	.tag-field {
		position: fixed;
		inset: 0;
		z-index: 2;
		opacity: calc(1 - var(--scroll-progress) * 0.94);
		transform: translateY(calc(var(--scroll-progress) * 22vh)) scale(calc(1 - var(--scroll-progress) * 0.08));
		pointer-events: auto;
		transition: opacity 160ms ease;
		will-change: opacity, transform;
	}

	.home.has-scrolled .tag-field {
		pointer-events: none;
	}

	.tag-bubble {
		position: absolute;
		left: var(--x);
		top: var(--y);
		display: grid;
		place-items: center;
		width: var(--size);
		height: var(--size);
		padding: 0.3rem;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 50%;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.045)),
			oklch(0.62 0.12 var(--hue) / 0.22);
		color: rgba(255, 255, 255, 0.9);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.24),
			0 18px 60px rgba(0, 0, 0, 0.24),
			0 0 34px oklch(0.72 0.14 var(--hue) / 0.18);
		text-align: center;
		text-decoration: none;
		touch-action: none;
		backdrop-filter: blur(18px) saturate(1.35);
		transform: translate(-50%, -50%) scale(0.2);
		animation:
			bubble-enter 820ms cubic-bezier(0.2, 0.9, 0.18, 1.08) forwards,
			drift 12s ease-in-out infinite;
		animation-delay: var(--delay), calc(0.85s + var(--delay) * -1);
		cursor: grab;
		will-change: transform;
	}

	.tag-bubble::before {
		position: absolute;
		inset: 10%;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: inherit;
		content: '';
		pointer-events: none;
	}

	.tag-bubble::after {
		position: absolute;
		left: 22%;
		top: 17%;
		width: 24%;
		height: 18%;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.32);
		filter: blur(1px);
		content: '';
		pointer-events: none;
	}

	.tag-bubble span {
		max-width: 100%;
		font-size: clamp(0.54rem, 0.72vw, 0.74rem);
		font-weight: 800;
		line-height: 1.16;
		overflow-wrap: anywhere;
		text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
	}

	.tag-bubble:hover,
	.tag-bubble.is-dragging {
		z-index: 4;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.36), rgba(255, 255, 255, 0.1)),
			oklch(0.78 0.08 var(--hue) / 0.36);
		color: white;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.35),
			0 28px 80px rgba(0, 0, 0, 0.34),
			0 0 44px oklch(0.78 0.16 var(--hue) / 0.28);
	}

	.tag-bubble.is-dragging {
		cursor: grabbing;
		animation-play-state: paused;
	}

	.bio {
		position: fixed;
		left: clamp(1rem, 4vw, 3rem);
		bottom: clamp(1rem, 4vw, 3rem);
		z-index: 3;
		width: min(410px, calc(100% - 2rem));
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 1.25rem;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.065)),
			rgba(18, 18, 27, 0.38);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.18),
			0 24px 80px rgba(0, 0, 0, 0.32);
		padding: 1rem;
		color: white;
		backdrop-filter: blur(20px) saturate(1.24);
		transform: translateY(calc(var(--scroll-progress) * 85px));
		opacity: calc(1 - var(--scroll-progress) * 0.8);
		transition: border-color 160ms ease, background 160ms ease;
	}

	.bio::before {
		position: absolute;
		inset: 0.65rem;
		z-index: -1;
		border-radius: 0.95rem;
		background: linear-gradient(135deg, oklch(0.78 0.14 245 / 0.12), transparent 62%);
		content: '';
	}

	.bio-kicker {
		width: fit-content;
		margin-bottom: 0.65rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.13);
		padding: 0.2rem 0.58rem;
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.name,
	.motto {
		margin: 0;
	}

	.name {
		font-size: 1.35rem;
		font-weight: 800;
	}

	.motto {
		max-width: 340px;
		margin-top: 0.42rem;
		color: rgba(255, 255, 255, 0.76);
		font-size: 0.92rem;
		line-height: 1.78;
	}

	.bio-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.9rem;
	}

	.bio-meta span {
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		padding: 0.18rem 0.5rem;
		color: rgba(255, 255, 255, 0.74);
		font-size: 0.72rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 1rem;
	}

	.links a {
		display: inline-grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.86rem;
		background: rgba(255, 255, 255, 0.1);
		color: white;
		text-decoration: none;
		backdrop-filter: blur(14px);
		transition: transform 160ms ease, background 160ms ease, color 160ms ease;
	}

	.links a span {
		font-size: 0.67rem;
		font-weight: 900;
	}

	.links a:hover {
		background: rgba(255, 255, 255, 0.9);
		color: rgb(var(--black));
		transform: translateY(-2px);
	}

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 1.35rem;
		z-index: 5;
		display: grid;
		place-items: center;
		width: 34px;
		height: 54px;
		border: 1px solid rgba(255, 255, 255, 0.26);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		transform: translateX(-50%);
		backdrop-filter: blur(12px);
	}

	.scroll-cue span {
		width: 5px;
		height: 10px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.76);
		animation: cue 1.8s ease-in-out infinite;
	}

	.explore-screen {
		z-index: 6;
		display: grid;
		align-content: center;
		gap: clamp(1.5rem, 4vw, 3rem);
		padding: clamp(5rem, 10vw, 8rem) clamp(1rem, 5vw, 5rem);
		background:
			linear-gradient(180deg, rgba(14, 14, 22, 0.68), rgba(18, 18, 28, 0.95) 34%, rgba(247, 246, 252, 0.94));
	}

	.explore-copy {
		width: min(960px, 100%);
		margin: 0 auto;
		color: white;
	}

	.explore-copy p {
		margin: 0 0 0.5rem;
		color: oklch(0.84 0.09 245);
		font-size: 0.78rem;
		font-weight: 900;
		text-transform: uppercase;
	}

	.explore-copy h2 {
		max-width: 680px;
		margin: 0;
		color: rgba(255, 255, 255, 0.92);
		font-size: clamp(2rem, 4vw, 4.2rem);
		line-height: 1.06;
	}

	.entry-grid,
	.tag-dock {
		width: min(960px, 100%);
		margin: 0 auto;
	}

	.entry-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.entry-card {
		display: grid;
		align-content: start;
		gap: 0.8rem;
		min-height: 190px;
		border: 1px solid rgba(24, 24, 34, 0.1);
		border-radius: 1.15rem;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 22px 80px rgba(17, 17, 25, 0.12);
		padding: 1.15rem;
		color: rgb(var(--black));
		text-decoration: none;
		backdrop-filter: blur(18px);
		transform: translateY(calc((1 - var(--scroll-progress)) * 32px));
		opacity: clamp(0, calc((var(--scroll-progress) - 0.44) * 2.4), 1);
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
	}

	.entry-card:hover {
		background: white;
		box-shadow: 0 28px 90px rgba(17, 17, 25, 0.18);
		transform: translateY(-4px);
	}

	.entry-icon {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 0.9rem;
		background: oklch(0.9 0.06 245);
		color: oklch(0.46 0.14 250);
	}

	.entry-card strong {
		font-size: 1.12rem;
	}

	.entry-card small {
		color: rgb(var(--gray));
		font-size: 0.86rem;
		line-height: 1.72;
	}

	.tag-dock {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.tag-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: 1px solid rgba(24, 24, 34, 0.1);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		box-shadow: 0 12px 34px rgba(17, 17, 25, 0.08);
		padding: 0.56rem 0.72rem;
		color: rgb(var(--black));
		text-decoration: none;
		backdrop-filter: blur(16px);
		transition: transform 160ms ease, background 160ms ease;
	}

	.tag-chip:hover {
		background: white;
		transform: translateY(-2px);
	}

	.tag-chip span {
		font-size: 0.84rem;
		font-weight: 800;
	}

	.tag-chip small {
		display: grid;
		place-items: center;
		min-width: 1.35rem;
		height: 1.35rem;
		border-radius: 999px;
		background: oklch(0.9 0.06 245);
		color: oklch(0.46 0.14 250);
		font-size: 0.72rem;
		font-weight: 900;
	}

	@keyframes bubble-enter {
		0% {
			opacity: 0;
			transform: translate(-50%, -50%) scale(0.2);
		}
		70% {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1.08);
		}
