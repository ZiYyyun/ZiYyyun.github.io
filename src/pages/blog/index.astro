---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const baseUrl = import.meta.env.BASE_URL;
const featured = posts[0];
const rest = posts.slice(1);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`笔记 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-hero">
				<p>Published Notes</p>
				<h1>笔记索引</h1>
				<span>{posts.length} 篇已发布笔记</span>
			</section>

			{
				featured && (
					<section class="featured">
						<a href={`${baseUrl}blog/${featured.id}/`}>
							<div>
								<span class="label">Latest</span>
								<h2>{featured.data.title}</h2>
								<p>{featured.data.description}</p>
								<small><FormattedDate date={featured.data.pubDate} /></small>
							</div>
							{featured.data.heroImage && typeof featured.data.heroImage !== 'string' && (
								<Image width={560} height={320} src={featured.data.heroImage} alt="" />
							)}
							{typeof featured.data.heroImage === 'string' &&
								(featured.data.heroImage.startsWith('/') || featured.data.heroImage.startsWith('http')) && (
									<img src={featured.data.heroImage} alt="" />
								)}
						</a>
					</section>
				)
			}

			<section class="post-grid" aria-label="全部笔记">
				{
					rest.map((post) => (
						<article>
							<a href={`${baseUrl}blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>
									<FormattedDate date={post.data.pubDate} />
								</time>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(1160px, calc(100% - 2rem));
	}

	.archive-hero {
		display: grid;
		gap: 0.25rem;
		margin: 2rem 0 2.2rem;
	}

	.archive-hero p {
		margin: 0;
		color: var(--accent);
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.archive-hero h1 {
		margin: 0;
	}

	.archive-hero span {
		color: rgb(var(--gray));
		font-size: 0.92rem;
	}

	.featured {
		margin-bottom: 1rem;
	}

	.featured a {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(240px, 0.72fr);
		gap: 1rem;
		min-height: 300px;
		border: 1px solid rgba(var(--black), 0.075);
		border-radius: 8px;
		background:
			linear-gradient(135deg, rgba(29, 111, 116, 0.12), transparent 46%),
			linear-gradient(315deg, rgba(191, 101, 66, 0.1), transparent 42%),
			rgba(var(--surface), 0.88);
		box-shadow: var(--soft-shadow);
		padding: clamp(1.25rem, 3vw, 2.1rem);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.featured a:hover {
		box-shadow: var(--lift-shadow);
		transform: translateY(-2px);
	}

	.featured a > div {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.label {
		width: fit-content;
		border: 1px solid rgba(var(--black), 0.12);
		border-radius: 999px;
		padding: 0.22rem 0.62rem;
		color: rgb(var(--gray));
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.featured h2 {
		max-width: 650px;
		margin: 1rem 0 0.8rem;
		font-size: clamp(1.75rem, 4.8vw, 3.4rem);
		line-height: 1.04;
	}

	.featured p {
		max-width: 620px;
		color: rgb(var(--gray));
		line-height: 1.72;
	}

	.featured small {
		color: rgb(var(--gray));
		font-size: 0.84rem;
	}

	.featured img {
		align-self: stretch;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	article a {
		display: grid;
		grid-template-rows: auto auto 1fr;
		min-height: 218px;
		border: 1px solid rgba(var(--black), 0.075);
		border-radius: 8px;
		background: rgba(var(--surface), 0.78);
		box-shadow: 0 12px 34px rgba(24, 30, 38, 0.05);
		padding: 1rem;
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	article a:hover {
		border-color: rgba(29, 111, 116, 0.36);
		box-shadow: var(--soft-shadow);
		transform: translateY(-2px);
	}

	time {
		color: rgb(var(--gray));
		font-size: 0.78rem;
	}

	article h2 {
		margin-top: 1.15rem;
		font-size: 1.14rem;
		line-height: 1.34;
	}

	article p {
		align-self: end;
		display: -webkit-box;
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.88rem;
		line-height: 1.62;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	@media (max-width: 920px) {
		.featured a {
			grid-template-columns: 1fr;
		}

		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 620px) {
		main {
			width: min(100% - 1rem, 1160px);
		}

		.post-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
