---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getTagSummaries } from '../../lib/tags';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tags = getTagSummaries(posts, import.meta.env.BASE_URL);

	return tags.map((tag) => ({
		params: { tag: tag.slug },
		props: tag,
	}));
}

const tag = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`#${tag.name} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="tag-page">
			<div class="tag-grid">
				<ProfileCard />
				<section class="content-column">
					<header class="page-heading">
						<p class="eyebrow">Tag Archive</p>
						<h1>#{tag.name}</h1>
						<p>{tag.posts.length} 篇笔记</p>
					</header>

					<section class="post-list">
						{
							tag.posts.map((post) => (
								<article class="tag-post fuwari-card">
									<a href={post.url}>
										<strong>{post.title}</strong>
										<span>{post.description}</span>
									</a>
								</article>
							))
						}
					</section>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tag-page {
		padding-top: 2rem;
	}

	.tag-grid {
		display: grid;
		grid-template-columns: 16.5rem minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.page-heading {
		margin: 0.6rem 0 1.2rem;
		padding: 0 0.25rem;
	}

	.eyebrow {
		margin: 0 0 0.35rem;
		color: var(--primary);
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.page-heading h1 {
		margin-bottom: 0.45rem;
		font-size: clamp(2.2rem, 5vw, 3.6rem);
	}

	.page-heading p:last-child {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.92rem;
	}

	.post-list {
		display: grid;
		gap: 0.8rem;
	}

	.tag-post {
		padding: 0.3rem;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.tag-post:hover {
		box-shadow: var(--shadow-lift);
		transform: translateY(-2px);
	}

	.tag-post a {
		display: grid;
		gap: 0.45rem;
		padding: 1rem 1.15rem;
		color: inherit;
		text-decoration: none;
	}

	strong {
		color: rgb(var(--black));
		font-size: 1.08rem;
	}

	span {
		color: rgb(var(--gray));
		font-size: 0.88rem;
		line-height: 1.58;
	}

	@media (max-width: 980px) {
		.tag-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
